# wireless-regdb - Wireless regulatory database
name=wireless-regdb
version=2026.05.30
release=2
desc="Wireless regulatory database"
url="https://git.kernel.org/pub/scm/linux/kernel/git/sforshee/wireless-regdb.git"
license="ISC"
depend=""
makedepend=""
source="https://kernel.org/pub/software/network/wireless-regdb/wireless-regdb-2026.05.30.tar.xz"
sha256="SKIP"

# No build step. The default make target regenerates regulatory.db from db.txt,
# which wants python and the private key the database is signed with - neither
# of which exists here, and neither of which is needed: the release tarball
# ships the signed binary database already built. Installing what upstream
# signed is also the only way the kernel will load it, since it checks the
# signature against a key compiled into cfg80211.
build() {
	:
}

package() {
	cd "wireless-regdb-$version"
	# /usr/lib/firmware, not /lib/firmware: ScrapLinux is merged-/usr and this is
	# where the kernel's firmware loader is pointed.
	install -Dm644 regulatory.db "$pkgdir/usr/lib/firmware/regulatory.db"
	install -Dm644 regulatory.db.p7s "$pkgdir/usr/lib/firmware/regulatory.db.p7s"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$name/LICENSE"
	install -Dm644 db.txt "$pkgdir/usr/share/$name/db.txt"
}
