name=libglvnd
version=1.7.0
release=3
desc="GL vendor dispatch, so mesa and NVIDIA can both provide GL"
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
license="MIT"
depend="glibc libx11 libxext"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v1.7.0/libglvnd-v1.7.0.tar.gz"
sha256="2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d"

build() {
	cd "libglvnd-v1.7.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libglvnd-v1.7.0"
	DESTDIR="$pkgdir" ninja -C build install
}
