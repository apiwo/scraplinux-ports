name=hwdata
version=0.410
release=3
desc="Hardware identification and configuration data (pci.ids, pnp.ids, usb.ids, ...)"
url="https://github.com/vcrhonek/hwdata"
license="GPL-2.0-or-later"
depend=""
makedepend=""
source="https://github.com/vcrhonek/hwdata/archive/refs/tags/v0.410.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "hwdata-0.410"
	./configure --prefix=/usr --libdir=/usr/lib --datadir=/usr/share
	make -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "hwdata-0.410"
	make DESTDIR="$pkgdir" install
	sed -i 's|\${pc_sysrootdir}||' "$pkgdir/usr/share/pkgconfig/hwdata.pc"
}
