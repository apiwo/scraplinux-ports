# python - The Python interpreter
name=python
version=3.14.7
release=2
desc="The Python interpreter"
url="https://python.org/"
license="Python-2.0"
depend="glibc libffi sqlite libressl zlib xz bzip2 libedit"
makedepend=""
source="https://www.python.org/ftp/python/3.14.7/Python-3.14.7.tar.xz"
sha256="SKIP"

build() {
	cd "Python-3.14.7"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	# ScrapLinux's only TLS is LibreSSL (never OpenSSL - see CONTRIBUTING.md),
	# installed to a plain /usr prefix with the standard openssl/ header
	# layout and libssl.so/libcrypto.so ABI. Without --with-openssl, CPython's
	# configure never looks for it at all: setup.py silently built with no
	# _ssl module (no error, no warning that survives the build log), and
	# every SSL-dependent tool downstream of that - pip, meson via pip,
	# ultimately xf86-input-libinput's build - failed on
	# "the ssl module is unavailable" with the actual cause nowhere in sight.
	#
	# --with-openssl=DIR is CPython's own configure logic, not routed through
	# --sysroot the way CFLAGS/LDFLAGS are - a bare /usr here resolved to the
	# *host's* real OpenSSL (proved by ssl.OPENSSL_VERSION reporting a plain
	# "OpenSSL 3.x" after the first attempt, not LibreSSL), exactly the
	# host-contamination bug the sysroot mechanism exists to prevent.
	# $SCRAPS_SYSROOT is what has LibreSSL actually built for ScrapLinux.
	_opts="$_opts --with-openssl=$SCRAPS_SYSROOT/usr --with-openssl-rpath=auto"
	# shellcheck disable=SC2086
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "Python-3.14.7"
	gmake DESTDIR="$pkgdir" install
}
