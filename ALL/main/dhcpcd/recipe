name=dhcpcd
version=10.5.2
release=1
desc="DHCP and DHCPv6 client, configures every interface iwd or a cable brings up"
url="https://github.com/NetworkConfiguration/dhcpcd"
license="BSD-2-Clause"
depend="glibc libmd"
makedepend="gmake"
source="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$version/dhcpcd-$version.tar.xz"
sha256="3e476657fdb6eeb38b277da3a48d0ac0113ecce5858ebdcddff2b629faed52b4"
backup="etc/dhcpcd.conf"

build() {
	cd "dhcpcd-$version"
	# the privsep user is otherwise guessed from the build host's passwd
	./configure --prefix=/usr --sbindir=/usr/bin --sysconfdir=/etc \
		--libexecdir=/usr/lib/dhcpcd --dbdir=/var/lib/dhcpcd --runstatedir=/run \
		--privsepuser=dhcpcd --without-openssl --without-udev
	gmake -j"$JOBS"
}

package() {
	cd "dhcpcd-$version"
	gmake DESTDIR="$pkgdir" install
}
