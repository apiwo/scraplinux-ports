name=perl
version=5.42.1
release=1
desc="Perl, needed to build openssl and git"
url="https://perl.org/"
license="Artistic-1.0-Perl GPL-1.0-or-later"
depend="glibc zlib bzip2"
makedepend=""
source="https://www.cpan.org/src/5.0/perl-5.42.1.tar.xz"
sha256="SKIP"

build() {
	cd "perl-5.42.1"
	sh Configure -des \
		-Dprefix=/usr \
		-Dcc=clang \
		-Dld=clang \
		-Dar=llvm-ar \
		-Dnm=llvm-nm \
		-Dranlib=llvm-ranlib \
		-Dmake=gmake \
		-Dusethreads
	gmake -j"$JOBS"
}

package() {
	cd "perl-5.42.1"
	gmake DESTDIR="$pkgdir" install
}
