name=scraps
version=1.5.2
release=1
desc="ScrapLinux Package Manager"
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="busybox onetrueawk xz libarchive curl"
provides="package-manager"
# takes etc/scraps over from older scraplinux-base
replaces="scraplinux-base"
_commit=2f045c7155f74f3c01db8956f5c7853d817c2c5a
source="scraplinux-$_commit.tar.gz::https://github.com/apiwo/scraplinux/archive/$_commit.tar.gz"
sha256="f878378531d3b1ab7de98871f3c01252155300d28bd6aec7de13dbfb9c81dcbe"
backup="etc/scraps/scraps.conf"

package() {
	unset LD_LIBRARY_PATH
	cd "scraplinux-$_commit"
	install -Dm755 scraps/scraps       "$pkgdir/usr/bin/scraps"
	install -Dm755 scraps/scraps-build "$pkgdir/usr/bin/scraps-build"
	install -Dm755 scraps/scraps-repo  "$pkgdir/usr/bin/scraps-repo"
	install -Dm755 scraps/scraps-strap "$pkgdir/usr/bin/scraps-strap"
	install -Dm644 scraps/libscraps.sh "$pkgdir/usr/lib/scraps/libscraps.sh"
	mkdir -p "$pkgdir/etc"
	cp -a skel/etc/scraps "$pkgdir/etc/scraps"
	install -d "$pkgdir/var/lib/scraps/local" "$pkgdir/var/lib/scraps/sync" \
		"$pkgdir/var/lib/scraps/hold" "$pkgdir/var/lib/scraps/snapshots" \
		"$pkgdir/var/cache/scraps/pkg" "$pkgdir/var/cache/scraps/src"
	# github archives are group writable, git's tar.umask is 0002
	chmod -R go-w "$pkgdir"
}
