name=ell
version=0.83
release=2
desc="Embedded Linux Library, iwd's base library"
url="https://git.kernel.org/pub/scm/libs/ell/ell.git"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend="gmake"
source="https://mirrors.edge.kernel.org/pub/linux/libs/ell/ell-$version.tar.xz"
sha256="39a562f5ab2768e69da1ffbb1f98a8eb3483baffc7d2ef6adc3705e4fd4e53fb"

build() {
	cd "ell-$version"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --disable-static
	gmake -j"$JOBS"
}

package() {
	cd "ell-$version"
	gmake DESTDIR="$pkgdir" install
}
