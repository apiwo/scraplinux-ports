# llvm - the Arctic toolchain. clang, lld, libc++ and the whole LLVM suite.
# This, not GCC, is what Arctic compiles with. GCC exists only on the build
# machines as a stage-0 tool for glibc, and is never packaged.
name=llvm
version=22.1.8
release=3
desc="The LLVM compiler infrastructure: clang, lld, libc++, lldb"
url="https://llvm.org/"
license="Apache-2.0-with-LLVM-exception"
depend="glibc zlib zstd libxml2"
makedepend="cmake ninja python"
provides="clang lld libcxx compiler"
# AMDGPU is in the target list because mesa needs it, not because Arctic
# targets AMD GPUs as a platform: radeonsi asks llvm-config for an amdgpu
# component and mesa refuses to configure without it, then tries to build
# LLVM as a subproject of itself.
#
# lldb and polly are left out deliberately. lldb wants swig and libedit and
# is the part of an LLVM build most likely to fail on a machine that does not
# have them; polly is an optimiser most packages never ask for. Neither is
# needed to compile Arctic, and a toolchain that builds is worth more than a
# toolchain that would have had a debugger in it.
#
# Linking is capped at four jobs regardless of how many cores do the
# compiling: LLVM's link steps are the memory-hungry ones and running one per
# core is how an LLVM build turns into an out-of-memory kill several hours in.
source="llvm-project-$version.src.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz"
sha256="SKIP"
options="!strip"

build() {
	cd "llvm-project-$version.src"
	cmake -S llvm -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLLVM_ENABLE_PROJECTS="clang;clang-tools-extra;lld" \
		-DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind;compiler-rt" \
		-DLLVM_TARGETS_TO_BUILD="X86;AArch64;RISCV;WebAssembly;AMDGPU" \
		-DLLVM_ENABLE_LLD=ON \
		-DLLVM_LINK_LLVM_DYLIB=ON \
		-DLLVM_ENABLE_RTTI=ON \
		-DLLVM_INSTALL_UTILS=ON \
		-DLLVM_BUILD_LLVM_DYLIB=ON \
		-DCLANG_DEFAULT_CXX_STDLIB=libc++ \
		-DCLANG_DEFAULT_RTLIB=compiler-rt \
		-DCLANG_DEFAULT_LINKER=lld \
		-DCLANG_DEFAULT_UNWINDLIB=libunwind \
		-DLIBCXX_USE_COMPILER_RT=ON \
		-DLIBCXXABI_USE_LLVM_UNWINDER=ON \
		-DLLVM_INCLUDE_TESTS=OFF \
		-DLLVM_INCLUDE_BENCHMARKS=OFF \
		-DLLVM_INCLUDE_EXAMPLES=OFF \
		-DLLVM_PARALLEL_LINK_JOBS=4
	ninja -C build -j"$JOBS"
}

package() {
	cd "llvm-project-$version.src"
	DESTDIR="$pkgdir" ninja -C build install
	# cc and c++ mean clang on Arctic.
	ln -sf clang "$pkgdir/usr/bin/cc"
	ln -sf clang++ "$pkgdir/usr/bin/c++"
	ln -sf ld.lld "$pkgdir/usr/bin/ld"
	# Anything invoking the plain, unprefixed GNU binutils names by
	# convention - autotools configure scripts, rustc's own build - has no
	# way to find them otherwise: Arctic only ships LLVM's own versions.
	ln -sf llvm-ar "$pkgdir/usr/bin/ar"
	ln -sf llvm-strip "$pkgdir/usr/bin/strip"
	# xorg-macros.m4 (used by every autotools-based Xorg library) probes
	# for a "cpp" binary specifically and, when found, uses it the
	# traditional gcc-cpp way: piping a file in on stdin with no explicit
	# input argument. Plain `clang -E` requires an explicit `-` for that
	# and errors "no input files" without one - clang-cpp is LLVM's own
	# binary built to behave like traditional cpp instead, stdin handling
	# included.
	ln -sf clang-cpp "$pkgdir/usr/bin/cpp"

	# LLVM_INSTALL_UTILS puts llvm-lit's helpers in /usr/bin, and two of them
	# are named after ordinary commands: "count" and "not". toybox owns both,
	# so installing llvm - which mesa depends on - stopped the transaction on
	# a file conflict and the whole graphics stack went with it. They are test
	# harness, useful only when running LLVM's own suite.
	rm -f "$pkgdir/usr/bin/count" "$pkgdir/usr/bin/not"
}
