# scraps - the ScrapLinux Package Manager itself.
# Deliberately thin: scraps has to work on a system with nothing else on it.
# (scraps-rs/ has a Rust rewrite sitting in the tree, unused for now.)
name=scraps
version=1.0.0
release=1
desc="ScrapLinux Package Manager"
url="https://github.com/apiwo/scraplinux"
license="BSD-2-Clause"
depend="busybox"
provides="package-manager"
source="scraps scraps-build scraps-repo libscraps.sh scraps.conf"
sha256="SKIP SKIP SKIP SKIP SKIP"
backup="etc/scraps/scraps.conf"

package() {
	install -Dm755 scraps       "$pkgdir/usr/bin/scraps"
	install -Dm755 scraps-build "$pkgdir/usr/bin/scraps-build"
	install -Dm755 scraps-repo  "$pkgdir/usr/bin/scraps-repo"
	install -Dm644 libscraps.sh "$pkgdir/usr/lib/scraps/libscraps.sh"
	install -Dm644 scraps.conf  "$pkgdir/etc/scraps/scraps.conf"
	install -d "$pkgdir/etc/scraps/repos.d"
	install -d "$pkgdir/var/lib/scraps/local" "$pkgdir/var/lib/scraps/sync"
	install -d "$pkgdir/var/lib/scraps/hold" "$pkgdir/var/lib/scraps/snapshots"
	install -d "$pkgdir/var/cache/scraps/pkg" "$pkgdir/var/cache/scraps/src"
}
