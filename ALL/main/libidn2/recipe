name=libidn2
version=2.3.7
release=1
desc="Internationalised domain names, which curl resolves hostnames with"
url="https://www.gnu.org/software/libidn/"
license="LGPL-3.0-or-later"
depend="glibc libunistring"
makedepend=""
source="https://ftp.gnu.org/gnu/libidn/libidn2-2.3.7.tar.gz"
sha256="SKIP"

build() {
	cd "libidn2-2.3.7"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "libidn2-2.3.7"
	make DESTDIR="$pkgdir" install
}
