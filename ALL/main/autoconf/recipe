name=autoconf
version=2.73
release=1
desc="Generates configure scripts from configure.ac, needed for packages that ship raw git-tag tarballs"
url="https://www.gnu.org/software/autoconf/"
license="GPL-3.0-or-later"
depend="glibc m4 perl"
makedepend=""
source="https://ftp.gnu.org/gnu/autoconf/autoconf-2.73.tar.xz"
sha256="SKIP"

build() {
	cd "autoconf-2.73"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "autoconf-2.73"
	gmake DESTDIR="$pkgdir" install
}
