# skalibs - skarnet base library, needed by s6
name=skalibs
version=2.14.4.0
release=1
desc="skarnet base library, needed by s6"
url="https://skarnet.org/software/skalibs/"
license="ISC"
depend="glibc"
makedepend=""
source="https://skarnet.org/software/skalibs/skalibs-2.14.4.0.tar.gz"
sha256="SKIP"

build() {
	# scraps-build exports LD_LIBRARY_PATH pointing at the sysroot before
	# build() runs - this recipe's plain ./configure/gmake never runs a
	# just-built binary against it, so the export only crashes host tools
	# instead (same fix as execline/s6/glibc-32's recipes already carry).
	unset LD_LIBRARY_PATH
	cd "skalibs-2.14.4.0"
	[ -x ./configure ] || autoreconf -fi
	# execline/s6/66/oblibs all statically link against libskarnet.a
	# (--enable-allstatic on their own configure) - explicitly keep static
	# archives here rather than letting the generic template's
	# --disable-static auto-detection strip them.
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--libdir=/usr/lib --enable-static
	gmake -j"$JOBS"
}

package() {
	cd "skalibs-2.14.4.0"
	gmake DESTDIR="$pkgdir" install
}
