name=libunistring
version=1.3
release=1
desc="Unicode string library"
url="https://www.gnu.org/software/libunistring/"
license="LGPL-3.0-or-later"
depend="glibc"
makedepend=""
source="https://ftp.gnu.org/gnu/libunistring/libunistring-1.3.tar.xz"
sha256="SKIP"

build() {
	cd "libunistring-1.3"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "libunistring-1.3"
	make DESTDIR="$pkgdir" install
}
