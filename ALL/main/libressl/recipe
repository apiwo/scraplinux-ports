# libressl - OpenBSD TLS, Arctic's default
name=libressl
version=4.2.0
release=4
desc="OpenBSD TLS, Arctic's default"
url="https://www.libressl.org/"
license="ISC Apache-2.0"
depend="glibc"
makedepend=""
source="https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-4.2.0.tar.gz"
sha256="SKIP"

build() {
	cd "libressl-4.2.0"
	# Not every configure script accepts the same options - sqlite rejects
	# --disable-nls outright, for instance - so only pass the ones this one
	# actually advertises. Guessing wrong fails the whole build.
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	# shellcheck disable=SC2086
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "libressl-$version"
	make DESTDIR="$pkgdir" install
	# The CA bundle belongs to ca-certificates, which is where it is kept up
	# to date. libressl installs its own placeholder at the same path, and
	# two packages owning one file is a hard conflict - "file conflict:
	# /etc/ssl/cert.pem is owned by libressl" was enough to stop any
	# transaction that included ca-certificates, which is most of them.
	rm -f "$pkgdir/etc/ssl/cert.pem"
	# openssl.cnf stays right here, under its real name. This library's own
	# compiled-in default config path (baked in via --sysconfdir=/etc at
	# ./configure time, the standard OPENSSLDIR/openssl.cnf convention) is
	# /etc/ssl/openssl.cnf, not configurable to a different filename short
	# of patching LibreSSL's own source. An earlier version of this recipe
	# renamed it to libressl.cnf to dodge an alpm ownership conflict with a
	# real-OpenSSL package Arctic used to also ship - that left this exact
	# path unclaimed, OpenSSL's incompatible provider-based config filled it
	# instead, and every LibreSSL-linked consumer (curl included) hard-
	# failed to even initialize ("unknown module name: module=providers" -
	# LibreSSL has no provider architecture at all). Arctic is LibreSSL-only
	# now - see CONTRIBUTING.md - so this file just keeps its real name.
}
