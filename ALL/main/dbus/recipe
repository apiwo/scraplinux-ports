# dbus - Desktop message bus
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=dbus
version=1.16.2
release=1
desc="Desktop message bus"
url="https://www.freedesktop.org/wiki/Software/dbus/"
license="AFL-2.1 GPL-2.0-or-later"
depend="glibc expat"
makedepend="meson ninja"
source="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"
sha256="SKIP"

build() {
	cd "dbus-1.16.2"
	# x11_autolaunch defaults to 'auto', so meson probed the build host for
	# libX11 and turned it on because it found one - not because ScrapLinux
	# ships X11. That put libX11.so.6 in dbus-launch's NEEDED list with
	# nothing on the target to satisfy it. ScrapLinux is TTY-based; disable it.
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true \
		-Dx11_autolaunch=disabled
	ninja -C build -j"$JOBS"
}

package() {
	cd "dbus-1.16.2"
	DESTDIR="$pkgdir" ninja -C build install
}
