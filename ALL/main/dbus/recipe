name=dbus
version=1.16.2
release=1
desc="Desktop message bus"
url="https://www.freedesktop.org/wiki/Software/dbus/"
license="AFL-2.1 GPL-2.0-or-later"
depend="glibc expat"
makedepend="meson ninja"
source="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"
sha256="SKIP"

build() {
	cd "dbus-1.16.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true \
		-Dx11_autolaunch=disabled
	ninja -C build -j"$JOBS"
}

package() {
	cd "dbus-1.16.2"
	DESTDIR="$pkgdir" ninja -C build install
}
