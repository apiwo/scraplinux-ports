# linux-headers - Kernel headers for userspace
# Hand-written - see recipe.local beside this file.
name=linux-headers
version=7.1.3
release=1
desc="Kernel headers for userspace"
url="https://kernel.org/"
license="GPL-2.0-only WITH Linux-syscall-note"
depend=""
makedepend=""
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.1.3.tar.xz"
sha256="SKIP"

package() {
	cd "linux-7.1.3"
	make headers_install INSTALL_HDR_PATH="$pkgdir/usr"
	find "$pkgdir/usr/include" -name '.*' -delete
	rm -f "$pkgdir/usr/include/Makefile"
}
