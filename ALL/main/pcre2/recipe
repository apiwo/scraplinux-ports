name=pcre2
version=10.46
release=1
desc="Perl compatible regular expressions"
url="https://pcre2project.github.io/pcre2/"
license="BSD-3-Clause"
depend="glibc zlib bzip2"
makedepend=""
source="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.bz2"
sha256="SKIP"

build() {
	cd "pcre2-10.46"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --enable-pcre2-8 --enable-pcre2-16 --enable-pcre2-32"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "pcre2-10.46"
	gmake DESTDIR="$pkgdir" install
}
