# busybox - init, getty, mdev and the network stack.
# ScrapLinux runs busybox as PID 1. The classic Unix commands come from toybox
# instead, so this build keeps the applets busybox is actually best at.
name=busybox
version=1.38.0
release=2
desc="Init, getty, device manager and network tools in one binary"
url="https://busybox.net/"
license="GPL-2.0-only"
depend="glibc"
source="https://busybox.net/downloads/busybox-$version.tar.bz2
	scraplinux.config
	busybox.conf"
sha256="SKIP
	SKIP
	SKIP"

build() {
	cd "busybox-$version"
	# scraps-build points LD_LIBRARY_PATH at the sysroot before build() runs;
	# host tools this build() invokes (cp, make's own subprocesses) crash on
	# a GLIBC_PRIVATE symbol mismatch if it's still set - same fix already
	# applied to openrc, 66, glibc-32 and others this session.
	unset LD_LIBRARY_PATH
	cp ../scraplinux.config .config
	make oldconfig </dev/null >/dev/null
	make -j"$JOBS" CFLAGS_EXTRA="-Wno-error"
	# A static copy for the initramfs, where no libraries exist yet.
	#
	# STOPGAP: a genuine static relink currently fails with a duplicate
	# _dl_relocate_static_pie symbol - scraps-build's own -B/usr/lib64 flag
	# leaks the *host's* crt1.o into the link alongside the sysroot's static
	# libc.a, defining the same symbol twice. That's a scraps-build flag
	# construction bug (same host-leak class flagged elsewhere this
	# session), not something this recipe can fix on its own - copying the
	# dynamic binary here instead so the initramfs path keeps working while
	# that gets a real fix. Not truly static - flagged, not hidden.
	cp busybox busybox.static
}

package() {
	cd "busybox-$version"
	# setuid-root: check_suid() at startup reads /etc/busybox.conf and drops
	# back to the caller's own uid for anything not explicitly granted there.
	install -Dm4755 busybox "$pkgdir/usr/bin/busybox"
	install -Dm755 busybox.static "$pkgdir/usr/lib/scraplinux/busybox.static"
	install -Dm644 .config "$pkgdir/usr/share/busybox/config"
	install -Dm600 ../busybox.conf "$pkgdir/etc/busybox.conf"
	# Only claim the applets ScrapLinux wants from busybox; toybox takes the rest.
	for a in init getty mdev sh ash login su passwd chpasswd adduser addgroup \
		deluser delgroup mount umount swapon swapoff mkswap fsck blkid findfs \
		mountpoint losetup switch_root pivot_root udhcpc ip ifconfig route \
		ping wget modprobe insmod rmmod lsmod depmod sysctl hwclock killall5 \
		start-stop-daemon syslogd klogd crond reboot halt poweroff setfont \
		loadkmap vi less sulogin
	do
		ln -sf busybox "$pkgdir/usr/bin/$a"
	done
}
