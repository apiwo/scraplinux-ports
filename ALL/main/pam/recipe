name=pam
version=1.7.2
release=1
desc="Pluggable authentication modules, library and pam_unix only"
url="https://github.com/linux-pam/linux-pam"
license="BSD-3-Clause"
depend="glibc libxcrypt"
makedepend="meson ninja"
source="https://github.com/linux-pam/linux-pam/releases/download/v1.7.2/Linux-PAM-1.7.2.tar.xz"
sha256="SKIP"

build() {
	cd "Linux-PAM-1.7.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Ddocs=disabled \
		-Dexamples=false \
		-Dselinux=disabled \
		-Daudit=disabled \
		-Dnis=disabled \
		-Dlogind=disabled \
		-Delogind=disabled \
		-Dpam_userdb=disabled \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "Linux-PAM-1.7.2"
	DESTDIR="$pkgdir" ninja -C build install
	chmod 4755 "$pkgdir/usr/bin/unix_chkpwd"
}
