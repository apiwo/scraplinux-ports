# cmake - Cross-platform build generator
name=cmake
version=4.2.1
release=2
desc="Cross-platform build generator"
url="https://cmake.org/"
license="BSD-3-Clause"
depend="glibc libressl curl expat zlib libarchive netbsd-curses"
makedepend=""
source="https://github.com/Kitware/CMake/releases/download/v4.2.1/cmake-4.2.1.tar.gz"
sha256="SKIP"

build() {
	cd "cmake-4.2.1"
	# CMake does not use autotools - it has its own bootstrap script, which
	# in turn generates a plain Makefile. -DCMAKE_USE_OPENSSL=OFF is the
	# actual fix here, not just the bootstrap mechanism: CMake vendors its
	# own copy of librhash (used for file(MD5/SHA...) et al) and, left to
	# its own defaults, links it against whatever OpenSSL it finds at
	# build time. A stray OpenSSL3 build once sat in this buildroot (see
	# arctic-libressl-only-no-openssl) and got linked in - producing a
	# cmake that needed libcrypto.so.3, a soname Arctic has never shipped
	# since Arctic is LibreSSL-only. That single missing library broke
	# every cmake invocation outright, LXQt's build included, since none
	# of them can even reach the "not a valid input file" stage without
	# cmake itself running at all.
	./bootstrap --prefix=/usr --parallel="$JOBS" -- -DCMAKE_USE_OPENSSL=OFF
	gmake -j"$JOBS"
}

package() {
	cd "cmake-4.2.1"
	gmake DESTDIR="$pkgdir" install
}
