name=gmake
version=4.4.1
release=1
desc="GNU make as gmake, for kernel modules; /usr/bin/make is still bmake"
url="https://www.gnu.org/software/make/"
license="GPL-3.0-or-later"
depend="glibc"
makedepend=""
source="https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz"
sha256="SKIP"

build() {
	cd "make-4.4.1"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "make-4.4.1"
	make DESTDIR="$pkgdir" install
}
