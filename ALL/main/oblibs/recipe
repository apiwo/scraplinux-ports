name=oblibs
version=0.4.0.1
release=1
desc="Obarun's base C library - what 66 links against"
url="https://git.obarun.org/Obarun/oblibs"
license="BSD-Zero-Clause"
depend="glibc"
makedepend="meson ninja"
source="https://git.obarun.org/Obarun/oblibs/-/archive/0.4.0.1/oblibs-0.4.0.1.tar.gz"
sha256="SKIP"

build() {
	cd "oblibs-0.4.0.1"
	unset LD_LIBRARY_PATH
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "oblibs-0.4.0.1"
	DESTDIR="$pkgdir" ninja -C build install
}
