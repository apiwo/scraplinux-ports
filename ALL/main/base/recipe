name=base
version=1.0.1
release=1
desc="A minimal but complete ScrapLinux system"
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="glibc busybox toybox zsh doas scraps scraplinux-base scraplinux-init curl libarchive mandoc onetrueawk libxcrypt iana-etc tzdata ca-certificates signify"
makedepend=""
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/scraplinux/meta"
	printf '%s\n' "glibc busybox toybox zsh doas scraps scraplinux-base scraplinux-init curl libarchive mandoc onetrueawk libxcrypt iana-etc tzdata ca-certificates signify" >"$pkgdir/usr/share/scraplinux/meta/base"
}
