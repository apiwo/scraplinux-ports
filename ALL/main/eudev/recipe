# eudev - Standalone udev, for desktops that need it
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=eudev
version=3.2.14
release=3
desc="Standalone udev, for desktops that need it"
url="https://github.com/eudev-project/eudev"
license="GPL-2.0-or-later"
depend="glibc libcap"
makedepend=""
source="https://github.com/eudev-project/eudev/releases/download/v3.2.14/eudev-3.2.14.tar.gz"
sha256="SKIP"

build() {
	cd "eudev-3.2.14"
	# Some release tarballs are raw git-tag archives with no generated
	# ./configure at all (only configure.ac/Makefile.am) - a proper "make
	# dist" tarball ships one, a GitHub/GitLab auto-generated source
	# archive does not. Bootstrap it ourselves when that happens.
	[ -x ./configure ] || autoreconf -fi
	# Not every configure script accepts the same options - sqlite rejects
	# --disable-nls outright, for instance - so only pass the ones this one
	# actually advertises. Guessing wrong fails the whole build.
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	# bmake is not GNU make - automake's dependency-tracking .deps
	# fragments need nested variable expansion bmake doesn't have.
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	# shellcheck disable=SC2086
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "eudev-3.2.14"
	gmake DESTDIR="$pkgdir" install
	# eudev installs the real udevadm at usr/bin/udevadm and leaves a
	# compatibility symlink at usr/sbin/udevadm pointing back at it - correct
	# on a split-/usr system, destructive here. ScrapLinux is merged-/usr
	# (/usr/sbin -> bin), so both entries name the *same* path: unpacking
	# wrote the 371 KB binary, then overwrote it with a symlink to itself.
	# udevadm was then unusable ("Too many levels of symbolic links"), so
	# every `udevadm trigger` in the boot path silently did nothing and no
	# driver for already-present hardware was ever loaded - the machine came
	# up with no wifi despite iwlwifi.ko and its firmware both being present
	# and correct. Nothing needs the second path when it is the first path.
	if [ -L "$pkgdir/usr/sbin/udevadm" ]; then
		rm -f "$pkgdir/usr/sbin/udevadm"
	fi
}
