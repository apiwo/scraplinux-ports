name=libcap
version=2.78
release=1
desc="POSIX capabilities library"
url="https://sites.google.com/site/fullycapable/"
license="BSD-3-Clause GPL-2.0-only"
depend="glibc"
makedepend=""
source="https://kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.78.tar.xz"
sha256="SKIP"

build() {
	cd "libcap-2.78"
	unset LD_LIBRARY_PATH
	make -j"$JOBS" PREFIX=/usr CC="$CC"
}

package() {
	cd "libcap-2.78"
	make PREFIX=/usr DESTDIR="$pkgdir" CC="$CC" install
}
