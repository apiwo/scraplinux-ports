# wpa_supplicant - WPA client, NetworkManager's wifi backend
#
# The generic "make" template (PREFIX=/usr in the extracted top level) does
# not work here: wpa_supplicant's own Makefile lives in the wpa_supplicant/
# subdirectory (the tarball also contains hostapd/ and a handful of other
# tools as siblings, not a single top-level build), and it needs a .config
# file - copied from a defconfig and edited, not generated by a configure
# script - before `make` does anything at all.
#
# CONFIG_TLS=openssl is wpa_supplicant's name for the OpenSSL API, which is
# what LibreSSL implements - it is not a choice of package. ScrapLinux has one
# TLS library and it is libressl; this used to link OpenSSL's libssl.so.3
# because openssl happened to be in the build sysroot at the time, and a base
# install then carried both. They claim the same headers and the same
# /usr/lib/libssl.so, so the second of them to be installed stopped the
# transaction and the install finished with no curl and no NetworkManager.
#
# Full EAP/802.1X support here (the common EAP methods), unlike the
# stripped-down
# WPA2-Personal-only build in build/build-usable.sh for the live/installer
# image: this is the package NetworkManager actually runs on an installed
# system, where enterprise wifi (a corporate or university network) is a
# completely ordinary thing to need.
name=wpa_supplicant
version=2.11
release=2
desc="WPA client, NetworkManager's wifi backend"
url="https://w1.fi/wpa_supplicant/"
license="BSD-3-Clause"
depend="glibc libressl libnl dbus"
makedepend=""
source="https://w1.fi/releases/wpa_supplicant-2.11.tar.gz"
sha256="SKIP"

build() {
	cd "wpa_supplicant-2.11/wpa_supplicant"
	{
		printf 'CONFIG_BACKEND=file\n'
		printf 'CONFIG_DRIVER_NL80211=y\n'
		printf 'CONFIG_LIBNL32=y\n'
		printf 'CONFIG_CTRL_IFACE=y\n'
		# NetworkManager talks to wpa_supplicant over D-Bus, not the plain
		# control socket - without these two it would still run, but
		# NetworkManager could never actually drive it.
		printf 'CONFIG_CTRL_IFACE_DBUS=y\n'
		printf 'CONFIG_CTRL_IFACE_DBUS_NEW=y\n'
		printf 'CONFIG_CTRL_IFACE_DBUS_INTROSPECTION=y\n'
		printf 'CONFIG_TLS=openssl\n'
		printf 'CONFIG_EAP_TLS=y\n'
		printf 'CONFIG_EAP_PEAP=y\n'
		printf 'CONFIG_EAP_TTLS=y\n'
		printf 'CONFIG_EAP_MD5=y\n'
		printf 'CONFIG_EAP_MSCHAPV2=y\n'
		printf 'CONFIG_EAP_GTC=y\n'
		printf 'CONFIG_IEEE8021X_EAPOL=y\n'
		printf 'CONFIG_WPS=y\n'
	} >.config
	make -j"$JOBS"
}

package() {
	cd "wpa_supplicant-2.11/wpa_supplicant"
	install -Dm755 wpa_supplicant "$pkgdir/usr/bin/wpa_supplicant"
	install -Dm755 wpa_cli        "$pkgdir/usr/bin/wpa_cli"
	install -Dm755 wpa_passphrase "$pkgdir/usr/bin/wpa_passphrase"
	install -d "$pkgdir/etc/wpa_supplicant"
	install -Dm644 dbus/fi.w1.wpa_supplicant1.service \
		"$pkgdir/usr/share/dbus-1/system-services/fi.w1.wpa_supplicant1.service" 2>/dev/null || :
	install -Dm644 dbus/dbus-wpa_supplicant.conf \
		"$pkgdir/usr/share/dbus-1/system.d/wpa_supplicant.conf" 2>/dev/null || :
}
