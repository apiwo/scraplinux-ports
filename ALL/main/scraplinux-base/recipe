name=scraplinux-base
version=1.6.0
release=2
desc="ScrapLinux base configuration, init scripts and branding"
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="busybox toybox zsh doas scraps dinit eudev dhcpcd iwd"
# takes /usr/bin/init over from whichever init the system had
replaces="busybox 66 openrc sysvinit runit initialization"
_commit=2f045c7155f74f3c01db8956f5c7853d817c2c5a
source="scraplinux-$_commit.tar.gz::https://github.com/apiwo/scraplinux/archive/$_commit.tar.gz"
sha256="f878378531d3b1ab7de98871f3c01252155300d28bd6aec7de13dbfb9c81dcbe"
backup="etc/passwd etc/group etc/shadow etc/gshadow etc/profile etc/zsh/zshrc etc/doas.conf"

package() {
	unset LD_LIBRARY_PATH
	cd "scraplinux-$_commit"
	cp -a skel/etc skel/usr "$pkgdir/"
	# scraps owns these
	rm -rf "$pkgdir/etc/scraps"
	install -d "$pkgdir/usr/share/scraplinux" "$pkgdir/var/lib/scraplinux" "$pkgdir/etc/zsh/zshrc.d"
	for d in ascii fastfetch icons limine misc plasma sddm wallpaper; do
		[ -e "branding/$d" ] && cp -a "branding/$d" "$pkgdir/usr/share/scraplinux/"
	done
	printf '#!/bin/sh\ncat /etc/scraplinux-release\n' >"$pkgdir/usr/bin/scraplinux-release"
	chmod 755 "$pkgdir/usr/bin/scraplinux-release"
	ln -s dinit "$pkgdir/usr/bin/init"
	# github archives are group writable, git's tar.umask is 0002
	chmod -R go-w "$pkgdir"
	chmod 600 "$pkgdir/etc/shadow"
	[ ! -f "$pkgdir/etc/gshadow" ] || chmod 600 "$pkgdir/etc/gshadow"
}
