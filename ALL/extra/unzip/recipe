name=unzip
version=6.0
release=1
desc="Extract PKZIP archives"
url="https://infozip.sourceforge.net/"
license="Info-ZIP"
depend="glibc bzip2"
makedepend=""
source="https://downloads.sourceforge.net/infozip/unzip60.tar.gz"
sha256="SKIP"

build() {
	cd "unzip60"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "unzip60"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
