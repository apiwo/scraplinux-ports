name=ncdu
version=2.9
release=1
desc="Disk usage analyser with a text UI"
url="https://dev.yorhel.nl/ncdu"
license="MIT"
depend="glibc netbsd-curses"
makedepend="zig"
source="https://dev.yorhel.nl/download/ncdu-2.9.tar.gz"
sha256="SKIP"

build() {
	cd "ncdu-2.9"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "ncdu-2.9"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
