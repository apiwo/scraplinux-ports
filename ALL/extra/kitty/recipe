name=kitty
version=0.48.2
release=1
desc="Fast, feature-rich terminal"
url="https://sw.kovidgoyal.net/kitty/"
license="GPL-3.0-only"
depend="glibc harfbuzz wayland libpng freetype fontconfig"
makedepend="python go"
source="https://github.com/kovidgoyal/kitty/releases/download/v0.48.2/kitty-0.48.2.tar.xz"
sha256="SKIP"

build() {
	cd "kitty-0.48.2"
	python -m build --wheel --no-isolation
}

package() {
	cd "kitty-0.48.2"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
