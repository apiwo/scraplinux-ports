name=zellij
version=0.44.0
release=1
desc="Terminal workspace multiplexer"
url="https://zellij.dev/"
license="MIT"
depend="glibc"
makedepend="rust cargo"
source="https://github.com/zellij-org/zellij/archive/refs/tags/v0.44.0.tar.gz"
sha256="SKIP"

build() {
	cd "zellij-0.44.0"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "zellij-0.44.0"
	install -Dm755 "target/release/zellij" "$pkgdir/usr/bin/zellij"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/zellij/$d"
	done
	true
}
