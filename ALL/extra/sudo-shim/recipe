name=sudo-shim
version=1.0.0
release=1
desc="A sudo-compatible wrapper around doas, for scripts that insist"
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="doas"
makedepend=""
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/scraplinux/meta"
	printf '%s\n' "doas" >"$pkgdir/usr/share/scraplinux/meta/sudo-shim"
}
