name=pciutils
version=3.14.0
release=2
replaces="toybox"
desc="lspci and setpci"
url="https://mj.ucw.cz/sw/pciutils/"
license="GPL-2.0-or-later"
depend="glibc zlib"
makedepend=""
source="https://kernel.org/pub/software/utils/pciutils/pciutils-3.14.0.tar.xz"
