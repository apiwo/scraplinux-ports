name=shellcheck
version=0.11.0
release=1
desc="Shell script linter"
url="https://www.shellcheck.net/"
license="GPL-3.0-only"
depend="glibc"
makedepend=""
source="https://github.com/koalaman/shellcheck/archive/refs/tags/v0.11.0.tar.gz"
sha256="SKIP"

build() {
	cd "shellcheck-0.11.0"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "shellcheck-0.11.0"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
