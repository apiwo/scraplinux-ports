name=less
version=679
release=2
replaces="busybox"
desc="Terminal pager"
url="https://greenwoodsoftware.com/less/"
license="GPL-3.0-or-later BSD-2-Clause"
depend="glibc netbsd-curses"
makedepend=""
source="https://www.greenwoodsoftware.com/less/less-679.tar.gz"
sha256="SKIP"

build() {
	cd "less-679"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "less-679"
	make DESTDIR="$pkgdir" install
}
