name=hyperfine
version=1.20.0
release=1
desc="Command-line benchmarking tool"
url="https://github.com/sharkdp/hyperfine"
license="MIT Apache-2.0"
depend="glibc"
makedepend="rust cargo"
source="https://github.com/sharkdp/hyperfine/archive/refs/tags/v1.20.0.tar.gz"
sha256="SKIP"

build() {
	cd "hyperfine-1.20.0"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "hyperfine-1.20.0"
	install -Dm755 "target/release/hyperfine" "$pkgdir/usr/bin/hyperfine"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/hyperfine/$d"
	done
	true
}
