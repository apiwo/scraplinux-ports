name=difftastic
version=0.65.0
release=1
desc="A diff that understands syntax"
url="https://difftastic.wilfred.me.uk/"
license="MIT"
depend="glibc"
makedepend="rust cargo"
source="https://github.com/Wilfred/difftastic/archive/refs/tags/0.65.0.tar.gz"
sha256="SKIP"

build() {
	cd "difftastic-0.65.0"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "difftastic-0.65.0"
	install -Dm755 "target/release/difft" "$pkgdir/usr/bin/difft"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/difftastic/$d"
	done
	true
}
