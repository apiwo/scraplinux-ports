name=perf
version=7.1.3
release=1
desc="Linux performance counters"
url="https://perf.wiki.kernel.org/"
license="GPL-2.0-only"
depend="glibc libelf numactl slang"
makedepend=""
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.1.3.tar.xz"
