name=zip
version=3.0
release=1
desc="Create PKZIP archives"
url="https://infozip.sourceforge.net/"
license="Info-ZIP"
depend="glibc bzip2"
makedepend=""
source="https://downloads.sourceforge.net/infozip/zip30.tar.gz"
sha256="SKIP"

build() {
	cd "zip30"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "zip30"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
