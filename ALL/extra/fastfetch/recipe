# fastfetch - system information, with the ScrapLinux logo already configured.
name=fastfetch
version=2.55.0
release=1
desc="System information tool, configured with the ScrapLinux logo"
url="https://github.com/fastfetch-cli/fastfetch"
license="MIT"
depend="glibc"
makedepend="cmake ninja clang lld"
source="fastfetch-$version.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz"
sha256="SKIP"

build() {
	cd "fastfetch-$version"
	# fastfetch's own CMakeLists.txt (not this toolchain) hardcodes
	# -Werror=incompatible-pointer-types into CMAKE_C_FLAGS itself, appended
	# after anything a caller passes in - so handing cmake a -Wno-error= of
	# our own on the command line loses, it just gets overridden by
	# upstream's own flag later in the same string. fastfetch's source
	# assigns strchr()'s return (char*) out of a const char* in a couple of
	# places (io_unix.c, FFstrbuf.c) - valid, ordinary C, just stricter than
	# this warning likes - so the build never reached "package with the
	# ScrapLinux logo" at all without this. Removing only that one flag from
	# upstream's own CMakeLists.txt line, not the whole WARNING_FLAGS set.
	sed -i 's/ -Werror=incompatible-pointer-types / /' CMakeLists.txt
	cd ..
	cmake -S "fastfetch-$version" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
		-DENABLE_SYSTEM_YYJSON=OFF
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	# Ship the ScrapLinux mark as fastfetch's logo, plus a matching config.
	# The source tree, not an installed-system path - nothing has that at
	# build time, only the source checkout does (SCRAPLINUX_TREE inside the
	# sandbox, but this also needs to work for a plain unsandboxed clone).
	logo="${SCRAPLINUX_TREE:-/home/apiwo/scraplinux}/branding/ascii/scraplinux-logo.txt"
	install -Dm644 "$logo" "$pkgdir/usr/share/fastfetch/logos/scraplinux.txt"
	mkdir -p "$(dirname $pkgdir/etc/xdg/fastfetch/config.jsonc)"
cat >"$pkgdir/etc/xdg/fastfetch/config.jsonc" <<-'JSON'
		{
		  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
		  "logo": {
		    "source": "/usr/share/fastfetch/logos/scraplinux.txt",
		    "type": "file",
		    "color": { "1": "#e8b923", "2": "#9a9892" },
		    "padding": { "top": 1, "left": 2 }
		  },
		  "display": { "separator": "  " },
		  "modules": [
		    "title",
		    "separator",
		    { "type": "os", "key": "os      " },
		    { "type": "host", "key": "host    " },
		    { "type": "kernel", "key": "kernel  " },
		    { "type": "uptime", "key": "uptime  " },
		    { "type": "packages", "key": "packages" },
		    { "type": "shell", "key": "shell   " },
		    { "type": "wm", "key": "wm      " },
		    { "type": "terminal", "key": "terminal" },
		    { "type": "cpu", "key": "cpu     " },
		    { "type": "gpu", "key": "gpu     " },
		    { "type": "memory", "key": "memory  " },
		    { "type": "disk", "key": "disk    " },
		    "break",
		    "colors"
		  ]
		}
JSON
chmod 644 "$pkgdir/etc/xdg/fastfetch/config.jsonc"
}
