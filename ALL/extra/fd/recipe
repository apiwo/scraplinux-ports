name=fd
version=10.4.2
release=1
desc="A simpler, faster find"
url="https://github.com/sharkdp/fd"
license="MIT Apache-2.0"
depend="glibc"
makedepend="rust cargo"
source="https://github.com/sharkdp/fd/archive/refs/tags/v10.4.2.tar.gz"
sha256="SKIP"

build() {
	cd "fd-10.4.2"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "fd-10.4.2"
	install -Dm755 "target/release/fd" "$pkgdir/usr/bin/fd"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/fd/$d"
	done
	true
}
