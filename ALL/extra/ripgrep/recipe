name=ripgrep
version=15.1.0
release=1
desc="Very fast recursive grep"
url="https://github.com/BurntSushi/ripgrep"
license="MIT Unlicense"
depend="glibc pcre2"
makedepend="rust cargo"
source="https://github.com/BurntSushi/ripgrep/archive/refs/tags/15.1.0.tar.gz"
sha256="SKIP"

build() {
	cd "ripgrep-15.1.0"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "ripgrep-15.1.0"
	install -Dm755 "target/release/rg" "$pkgdir/usr/bin/rg"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/ripgrep/$d"
	done
	true
}
