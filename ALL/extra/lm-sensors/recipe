name=lm-sensors
version=3.6.2
release=1
desc="Hardware monitoring"
url="https://github.com/lm-sensors/lm-sensors"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend="flex-alt byacc"
source="https://github.com/lm-sensors/lm-sensors/archive/refs/tags/V3-6-2.tar.gz"
sha256="SKIP"

build() {
	cd "lm-sensors-V3-6-2"
	gmake -j"$JOBS" PREFIX=/usr CC=clang AR=llvm-ar RANLIB=llvm-ranlib
}

package() {
	cd "lm-sensors-V3-6-2"
	gmake PREFIX=/usr DESTDIR="$pkgdir" CC=clang AR=llvm-ar RANLIB=llvm-ranlib install
}
