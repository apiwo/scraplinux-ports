name=facetimehd
version=0.7.0
release=1
desc="Apple FaceTime HD camera driver"
url="https://github.com/patjak/facetimehd"
license="GPL-2.0-only"
depend="glibc"
makedepend="linux-headers"
source="https://github.com/patjak/facetimehd/archive/refs/tags/0.7.0.tar.gz"
sha256="SKIP"

build() {
	cd "facetimehd-0.7.0"
	for kdir in /usr/lib/modules/*/build; do
		[ -d "$kdir" ] || continue
		gmake -C "$kdir" M="$PWD" modules
	done
}

package() {
	cd "facetimehd-0.7.0"
	for kver in $(ls /usr/lib/modules); do
		install -d "$pkgdir/usr/lib/modules/$kver/extra"
		for ko in *.ko; do
			[ -f "$ko" ] && install -Dm644 "$ko" \
				"$pkgdir/usr/lib/modules/$kver/extra/$ko"
		done
	done
	true
}
