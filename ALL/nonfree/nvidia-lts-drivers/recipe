name=nvidia-lts-drivers
version=590.48
release=1
desc="NVIDIA driver built for the LTS kernel"
url="https://www.nvidia.com/"
license="NVIDIA-proprietary"
depend="glibc ScrapLinux-lts-kernel"
makedepend="linux-headers"
source="https://us.download.nvidia.com/XFree86/Linux-x86_64/590.48/NVIDIA-Linux-x86_64-590.48.run"
sha256="SKIP"

build() {
	cd "NVIDIA-Linux-x86_64-590.48.run"
	for kdir in /usr/lib/modules/*/build; do
		[ -d "$kdir" ] || continue
		gmake -C "$kdir" M="$PWD" modules
	done
}

package() {
	cd "NVIDIA-Linux-x86_64-590.48.run"
	for kver in $(ls /usr/lib/modules); do
		install -d "$pkgdir/usr/lib/modules/$kver/extra"
		for ko in *.ko; do
			[ -f "$ko" ] && install -Dm644 "$ko" \
				"$pkgdir/usr/lib/modules/$kver/extra/$ko"
		done
	done
	true
}
