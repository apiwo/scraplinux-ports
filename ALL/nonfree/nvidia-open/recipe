name=nvidia-open
version=595.84
release=1
desc="NVIDIA open kernel modules for Turing and newer"
url="https://github.com/NVIDIA/open-gpu-kernel-modules"
license="MIT GPL-2.0-only"
depend="glibc"
makedepend="linux-headers"
source="https://github.com/NVIDIA/open-gpu-kernel-modules/archive/refs/tags/595.84.tar.gz"
sha256="SKIP"

build() {
	cd "open-gpu-kernel-modules-595.84"
	for kdir in /usr/lib/modules/*/build; do
		[ -d "$kdir" ] || continue
		gmake -C "$kdir" M="$PWD" modules
	done
}

package() {
	cd "open-gpu-kernel-modules-595.84"
	for kver in $(ls /usr/lib/modules); do
		install -d "$pkgdir/usr/lib/modules/$kver/extra"
		for ko in *.ko; do
			[ -f "$ko" ] && install -Dm644 "$ko" \
				"$pkgdir/usr/lib/modules/$kver/extra/$ko"
		done
	done
	true
}
