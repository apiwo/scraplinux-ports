name=vte3
version=0.82.0
release=2
desc="Terminal widget library"
url="https://gitlab.gnome.org/GNOME/vte"
license="LGPL-3.0-only"
depend="gtk3 pango pcre2 glib"
makedepend="meson ninja"
source="https://download.gnome.org/sources/vte/0.82/vte-0.82.0.tar.xz"
sha256="SKIP"

build() {
	cd "vte-0.82.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=false \
		-D_systemd=false \
		-Dvapi=false
	ninja -C build -j"$JOBS"
}

package() {
	cd "vte-0.82.0"
	DESTDIR="$pkgdir" ninja -C build install
}
