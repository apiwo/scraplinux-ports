name=xorgproto
version=2025.1
release=1
desc="X11 protocol headers"
url="https://gitlab.freedesktop.org/xorg/proto/xorgproto"
license="MIT"
depend=""
makedepend="meson ninja"
source="https://xorg.freedesktop.org/archive/individual/proto/xorgproto-2025.1.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "xorgproto-2025.1"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "xorgproto-2025.1"
	DESTDIR="$pkgdir" ninja -C build install
}
