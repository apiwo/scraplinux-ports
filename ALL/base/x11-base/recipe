name=x11-base
version=1.0.0
release=1
desc="Everything needed for a working X11 session: the server, xinit/startx, input and video drivers, keymaps, GL and fonts. Install this and startx works."
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="xorg-server xorg-xinit xauth libx11 libxext libxcb xcb-proto libxau libxdmcp xtrans libxrandr libxi libxcursor libxfixes libxrender libxinerama libxcomposite libxdamage libxtst libxv libxxf86vm libxkbcommon xkeyboard-config libpciaccess mesa libglvnd mtdev libevdev xf86-input-libinput xf86-video-amdgpu xf86-video-nouveau pixman font-util encodings font-misc-misc xkbcomp setxkbmap xrandr xset dbus ttf-jetbrains-mono-nerd"
makedepend="clang bmake"
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/scraplinux/meta"
	printf '%s\n' "xorg-server xorg-xinit xauth libx11 libxext libxcb xcb-proto libxau libxdmcp xtrans libxrandr libxi libxcursor libxfixes libxrender libxinerama libxcomposite libxdamage libxtst libxv libxxf86vm libxkbcommon xkeyboard-config libpciaccess mesa libglvnd mtdev libevdev xf86-input-libinput xf86-video-amdgpu xf86-video-nouveau pixman font-util encodings font-misc-misc xkbcomp setxkbmap xrandr xset dbus ttf-jetbrains-mono-nerd" >"$pkgdir/usr/share/scraplinux/meta/x11-base"
}
