name=greetd
version=0.10.3
release=1
desc="Minimal login daemon"
url="https://sr.ht/~kennylevinsen/greetd/"
license="GPL-3.0-only"
depend="glibc libxcrypt"
makedepend="rust cargo"
source="https://git.sr.ht/~kennylevinsen/greetd/archive/0.10.3.tar.gz"
sha256="SKIP"

build() {
	cd "greetd-0.10.3"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "greetd-0.10.3"
	install -Dm755 "target/release/greetd" "$pkgdir/usr/bin/greetd"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/greetd/$d"
	done
	true
}
