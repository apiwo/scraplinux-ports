name=yazi
version=26.5.6
release=1
desc="Terminal file manager"
url="https://yazi-rs.github.io/"
license="MIT"
depend="glibc ffmpeg libwebp"
makedepend="rust cargo"
source="https://github.com/sxyazi/yazi/archive/refs/tags/v26.5.6.tar.gz"
sha256="SKIP"

build() {
	cd "yazi-26.5.6"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "yazi-26.5.6"
	install -Dm755 "target/release/yazi" "$pkgdir/usr/bin/yazi"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/yazi/$d"
	done
	true
}
