name=gtk4
version=4.22.2
release=1
desc="GTK 4 toolkit"
url="https://gtk.org/"
license="LGPL-2.1-or-later"
depend="glib cairo pango gdk-pixbuf wayland libx11 graphene vulkan-loader"
makedepend="meson ninja"
source="https://download.gnome.org/sources/gtk/4.22/gtk-4.22.2.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "gtk-4.22.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "gtk-4.22.2"
	DESTDIR="$pkgdir" ninja -C build install
}
