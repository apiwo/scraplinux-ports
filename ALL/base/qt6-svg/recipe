# qt6-svg - Qt 6 SVG support
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=qt6-svg
version=6.10.1
release=1
desc="Qt 6 SVG support"
url="https://qt.io/"
license="LGPL-3.0-only"
depend="qt6-base"
makedepend="cmake ninja"
source="https://download.qt.io/official_releases/qt/6.10/6.10.1/submodules/qtsvg-everywhere-src-6.10.1.tar.xz"
sha256="SKIP"

build() {
	# No precompiled header. Qt's PCH TU hits a real libc++ 22 edge case:
	# <random>'s poisson_distribution.h calls std::abs(double), pulled in by
	# a using-declaration in libc++'s <cmath> that is a no-op rather than a
	# hard error when no matching ::abs overload is visible yet at that
	# point in the PCH's own header order - so the template overload libc++
	# normally supplies never gets a chance to apply, and the call is left
	# unresolved. A normal (non-PCH) compile of the same code does not hit
	# this, because each translation unit's own #include order reaches the
	# real overloads first. Disabling the PCH is the standard workaround for
	# this class of PCH-order sensitivity.
	# CMAKE_PREFIX_PATH/CMAKE_FIND_ROOT_PATH pinned to /usr, and
	# find_package() barred from touching anything else: without this
	# cmake's own package registry finds the host's own Qt install (bind-
	# mounted at /host for cmake/ninja/python themselves, none of which
	# are real ScrapLinux packages yet) ahead of the one actually being built
	# against here, and every private header comes from the wrong Qt.
	cmake -S "qtsvg-everywhere-src-6.10.1" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON \
		-DCMAKE_PREFIX_PATH=/usr \
		-DCMAKE_FIND_ROOT_PATH=/usr \
		-DCMAKE_FIND_USE_CMAKE_SYSTEM_PATH=OFF \
		-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF \
		-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF \
		-DQT_DEFAULT_MAJOR_VERSION=6
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
