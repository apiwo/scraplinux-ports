name=libplacebo
version=7.351.0
release=1
desc="GPU video rendering library"
url="https://libplacebo.org/"
license="LGPL-2.1-or-later"
depend="glibc vulkan-loader mesa"
makedepend="meson ninja"
source="https://code.videolan.org/videolan/libplacebo/-/archive/v7.351.0/libplacebo-v7.351.0.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libplacebo-v7.351.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libplacebo-v7.351.0"
	DESTDIR="$pkgdir" ninja -C build install
}
