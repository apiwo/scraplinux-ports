name=libdrm
version=2.4.130
release=2
desc="Direct Rendering Manager library"
url="https://dri.freedesktop.org/"
license="MIT"
depend="glibc libpciaccess"
makedepend="meson ninja"
source="https://dri.freedesktop.org/libdrm/libdrm-2.4.130.tar.xz"
sha256="SKIP"

build() {
	cd "libdrm-2.4.130"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Damdgpu=enabled \
		-Dradeon=enabled \
		-Dintel=enabled \
		-Dnouveau=enabled \
		-Dvmwgfx=enabled \
		-Dman-pages=disabled \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libdrm-2.4.130"
	DESTDIR="$pkgdir" ninja -C build install
}
