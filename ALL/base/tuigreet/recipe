name=tuigreet
version=0.9.1
release=1
desc="Console greeter for greetd"
url="https://github.com/apognu/tuigreet"
license="GPL-3.0-only"
depend="greetd"
makedepend="rust cargo"
source="https://github.com/apognu/tuigreet/archive/refs/tags/0.9.1.tar.gz"
sha256="SKIP"

build() {
	cd "tuigreet-0.9.1"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "tuigreet-0.9.1"
	install -Dm755 "target/release/tuigreet" "$pkgdir/usr/bin/tuigreet"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/tuigreet/$d"
	done
	true
}
