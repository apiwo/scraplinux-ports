# scraplinux-plasma-theme - the ScrapLinux look for Plasma, SDDM and the icon theme.
name=scraplinux-plasma-theme
version=1.0.0
release=1
desc="ScrapLinux theme, wallpapers and icons for KDE Plasma"
url="https://github.com/apiwo/scraplinux"
license="BSD-2-Clause CC-BY-SA-4.0"
depend="plasma-workspace"
source="branding.tar"
sha256="SKIP"

package() {
	install -d "$pkgdir/usr/share"
	tar -xf branding.tar -C "$pkgdir/usr/share/scraplinux-theme"

	# Icon theme, so the logo shows up wherever an app icon is wanted.
	install -d "$pkgdir/usr/share/icons"
	cp -a "$pkgdir/usr/share/scraplinux-theme/icons/hicolor" \
		"$pkgdir/usr/share/icons/hicolor-scraplinux"

	# Wallpaper, in the layout Plasma expects.
	wp="$pkgdir/usr/share/wallpapers/ScrapLinux/contents/images"
	install -d "$wp"
	for f in "$pkgdir"/usr/share/scraplinux-theme/wallpaper/scraplinux-*.png; do
		n=$(basename "$f" .png); n=${n#scraplinux-}
		install -Dm644 "$f" "$wp/$n.png"
	done
	mkdir -p "$(dirname $pkgdir/usr/share/wallpapers/ScrapLinux/metadata.json)"
cat >"$pkgdir/usr/share/wallpapers/ScrapLinux/metadata.json" <<-'JSON'
		{
		  "KPlugin": {
		    "Id": "ScrapLinux",
		    "Name": "ScrapLinux",
		    "License": "CC-BY-SA-4.0"
		  }
		}
JSON
chmod 644 "$pkgdir/usr/share/wallpapers/ScrapLinux/metadata.json"

	# The Plasma splash and the logo used by the application launcher.
	install -Dm644 "$pkgdir/usr/share/scraplinux-theme/plasma/scraplinux-logo.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/scraplinux.svg"
}
