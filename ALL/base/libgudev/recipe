name=libgudev
version=238
release=1
desc="GObject bindings for libudev"
url="https://gitlab.gnome.org/GNOME/libgudev"
license="LGPL-2.1-or-later"
depend="glib libudev-zero"
makedepend="meson ninja"
source="https://download.gnome.org/sources/libgudev/238/libgudev-238.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libgudev-238"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libgudev-238"
	DESTDIR="$pkgdir" ninja -C build install
}
