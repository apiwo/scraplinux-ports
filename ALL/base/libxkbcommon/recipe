name=libxkbcommon
version=1.13.2
release=1
desc="Keyboard handling library"
url="https://xkbcommon.org/"
license="MIT"
depend="glibc xkeyboard-config libxml2"
makedepend="meson ninja"
source="https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-1.13.2.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libxkbcommon-xkbcommon-1.13.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libxkbcommon-xkbcommon-1.13.2"
	DESTDIR="$pkgdir" ninja -C build install
}
