name=libdisplay-info
version=0.3.0
release=1
desc="EDID and DisplayID parsing library, a wlroots dependency"
url="https://gitlab.freedesktop.org/emersion/libdisplay-info"
license="MIT"
depend="glibc hwdata"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/emersion/libdisplay-info/-/archive/0.3.0/libdisplay-info-0.3.0.tar.gz"
sha256="SKIP"

build() {
	cd "libdisplay-info-0.3.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libdisplay-info-0.3.0"
	DESTDIR="$pkgdir" ninja -C build install
}
