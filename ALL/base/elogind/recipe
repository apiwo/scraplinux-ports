# elogind - Session/seat tracking, the systemd-logind fork for init systems without systemd
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=elogind
version=257.16
release=1
desc="Session/seat tracking, the systemd-logind fork for init systems without systemd"
url="https://github.com/elogind/elogind"
license="LGPL-2.1-or-later"
depend="glibc libcap pam util-linux-libs acl dbus"
makedepend="meson ninja"
source="https://github.com/elogind/elogind/archive/refs/tags/v257.16.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "elogind-257.16"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "elogind-257.16"
	DESTDIR="$pkgdir" ninja -C build install
}
