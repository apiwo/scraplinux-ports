name=xcb-proto
version=1.17.0
release=2
desc="XML descriptions of the X protocol, needed to build libxcb"
url="https://xcb.freedesktop.org/"
license="MIT"
depend="glibc"
makedepend="python"
source="https://xorg.freedesktop.org/archive/individual/proto/xcb-proto-1.17.0.tar.xz"
sha256="SKIP"

build() {
	cd "xcb-proto-1.17.0"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "xcb-proto-1.17.0"
	make DESTDIR="$pkgdir" install
}
