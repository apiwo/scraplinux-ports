name=libev
version=4.33
release=2
desc="High performance event loop"
url="http://software.schmorp.de/pkg/libev.html"
license="BSD-2-Clause"
depend="glibc"
makedepend=""
source="http://dist.schmorp.de/libev/libev-4.33.tar.gz"
sha256="SKIP"

build() {
	cd "libev-4.33"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "libev-4.33"
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/include/event.h"
}
