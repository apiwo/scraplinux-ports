name=font-misc-misc
version=1.1.3
release=1
desc="Core bitmap fonts (fixed, 6x13, ...) - the traditional default X font set"
url="https://x.org/"
license="MIT"
depend="glibc font-util encodings"
makedepend=""
source="https://x.org/pub/individual/font/font-misc-misc-1.1.3.tar.gz"
sha256="SKIP"

build() {
	cd "font-misc-misc-1.1.3"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	case "$_help" in *--with-compression*) _opts="$_opts --with-compression=no" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "font-misc-misc-1.1.3"
	gmake DESTDIR="$pkgdir" install
}
