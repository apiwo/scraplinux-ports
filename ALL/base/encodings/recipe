name=encodings
version=1.1.0
release=2
desc="Font encoding tables for X11 core fonts"
url="https://x.org/"
license="MIT"
depend=""
makedepend="font-util mkfontscale gmake"
source="https://x.org/pub/individual/font/encodings-$version.tar.gz"
sha256="7d9b7afedc97c3b29b6262b3346728b877f0a91a4a5802bf091df4cffb43a568"

build() {
	cd "encodings-$version"
	# fontrootdir from pkg-config points into the build sysroot
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--with-fontrootdir=/usr/share/fonts/X11
	gmake -j"$JOBS"
}

package() {
	cd "encodings-$version"
	gmake DESTDIR="$pkgdir" install
}
