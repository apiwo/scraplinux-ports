name=encodings
version=1.1.0
release=1
desc="Font encoding tables, needed by legacy X core fonts to load at all"
url="https://x.org/"
license="MIT"
depend="glibc font-util"
makedepend=""
source="https://x.org/pub/individual/font/encodings-1.1.0.tar.gz"
sha256="SKIP"

build() {
	cd "encodings-1.1.0"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	case "$_help" in *--disable-gzip-small-encodings*) _opts="$_opts --disable-gzip-small-encodings" ;; esac
	case "$_help" in *--disable-gzip-large-encodings*) _opts="$_opts --disable-gzip-large-encodings" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "encodings-1.1.0"
	gmake DESTDIR="$pkgdir" install
}
