# encodings - Font encoding tables, needed by legacy X core fonts to load at all
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=encodings
version=1.1.0
release=1
desc="Font encoding tables, needed by legacy X core fonts to load at all"
url="https://x.org/"
license="MIT"
depend="glibc font-util"
makedepend=""
source="https://x.org/pub/individual/font/encodings-1.1.0.tar.gz"
sha256="SKIP"

build() {
	cd "encodings-1.1.0"
	# Some release tarballs are raw git-tag archives with no generated
	# ./configure at all (only configure.ac/Makefile.am) - a proper "make
	# dist" tarball ships one, a GitHub/GitLab auto-generated source
	# archive does not. Bootstrap it ourselves when that happens.
	[ -x ./configure ] || autoreconf -fi
	# Not every configure script accepts the same options - sqlite rejects
	# --disable-nls outright, for instance - so only pass the ones this one
	# actually advertises. Guessing wrong fails the whole build.
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	# bmake is not GNU make - automake's dependency-tracking .deps
	# fragments need nested variable expansion bmake doesn't have.
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	# No working gzip on ScrapLinux (neither toybox nor busybox provides
	# it) - encodings' configure defaults to gzip-compressing its font
	# encoding tables and refuses outright ("gzip is needed to compress
	# font encodings") otherwise. Nothing reads a gzipped encoding table
	# any differently than a plain one - X's own font loader decompresses
	# on demand either way - so uncompressed is a real option here, not
	# a workaround with a cost.
	case "$_help" in *--disable-gzip-small-encodings*) _opts="$_opts --disable-gzip-small-encodings" ;; esac
	case "$_help" in *--disable-gzip-large-encodings*) _opts="$_opts --disable-gzip-large-encodings" ;; esac
	# shellcheck disable=SC2086
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "encodings-1.1.0"
	gmake DESTDIR="$pkgdir" install
}
