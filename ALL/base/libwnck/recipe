name=libwnck
version=43.3
release=1
desc="Window navigator construction kit"
url="https://gitlab.gnome.org/GNOME/libwnck"
license="LGPL-2.0-or-later"
depend="gtk3 libx11 libxres"
makedepend="meson ninja"
source="https://download.gnome.org/sources/libwnck/43/libwnck-43.3.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libwnck-43.3"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libwnck-43.3"
	DESTDIR="$pkgdir" ninja -C build install
}
