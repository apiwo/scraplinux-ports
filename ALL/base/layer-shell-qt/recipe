name=layer-shell-qt
version=6.5.0
release=1
desc="Qt6 bindings for the wlr-layer-shell Wayland protocol, needed by lxqt-session even on X11 builds (linked unconditionally)"
url="https://api.kde.org/layer-shell-qt/"
license="LGPL-2.1-or-later"
depend="qt6-base qt6-wayland wayland"
makedepend="cmake ninja"
source="https://download.kde.org/stable/plasma/6.5.0/layer-shell-qt-6.5.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "layer-shell-qt-6.5.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_PREFIX_PATH=/usr \
		-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF \
		-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF \
		-DCMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH=OFF \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_CXX_FLAGS="-I/usr/include/QtCore/6.10.1 -I/usr/include/QtCore/6.10.1/QtCore -I/usr/include/QtGui/6.10.1 -I/usr/include/QtGui/6.10.1/QtGui -I/usr/include/QtWidgets/6.10.1 -I/usr/include/QtWidgets/6.10.1/QtWidgets -I/usr/include/QtDBus/6.10.1 -I/usr/include/QtDBus/6.10.1/QtDBus -I/usr/include/QtNetwork/6.10.1 -I/usr/include/QtNetwork/6.10.1/QtNetwork"
	unset LD_LIBRARY_PATH
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
