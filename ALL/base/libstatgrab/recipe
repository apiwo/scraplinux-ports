name=libstatgrab
version=0.92.1
release=1
desc="System statistics library, needed by lxqt-panel's CPU load plugin"
url="https://github.com/libstatgrab/libstatgrab"
license="GPL-3.0-or-later"
depend="glibc"
makedepend=""
source="https://github.com/libstatgrab/libstatgrab/releases/download/LIBSTATGRAB_0_92_1/libstatgrab-0.92.1.tar.gz"
sha256="SKIP"

build() {
	cd "libstatgrab-0.92.1"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "libstatgrab-0.92.1"
	gmake DESTDIR="$pkgdir" install
}
