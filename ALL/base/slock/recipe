name=slock
version=1.5
release=1
desc="Simple X screen locker"
url="https://tools.suckless.org/slock/"
license="MIT"
depend="libx11 libxext libxrandr libxcrypt"
makedepend="bmake"
source="https://dl.suckless.org/tools/slock-1.5.tar.gz"
sha256="SKIP"

build() {
	cd "slock-1.5"
	[ -f config.def.h ] && cp -f config.def.h config.h
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "slock-1.5"
	make PREFIX=/usr DESTDIR="$pkgdir" install
	[ -f config.h ] && install -Dm644 config.h "$pkgdir/usr/share/slock/config.h"
	true
}
