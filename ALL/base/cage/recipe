name=cage
version=0.3.1
release=1
desc="Kiosk compositor that runs a single application, wlroots-based"
url="https://github.com/cage-kiosk/cage"
license="MIT"
depend="wlroots wayland libxkbcommon"
makedepend="meson ninja"
source="https://github.com/cage-kiosk/cage/archive/refs/tags/v0.3.1.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "cage-0.3.1"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "cage-0.3.1"
	DESTDIR="$pkgdir" ninja -C build install
}
