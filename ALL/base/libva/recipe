name=libva
version=2.24.0
release=1
desc="Video Acceleration API"
url="https://github.com/intel/libva"
license="MIT"
depend="glibc libdrm libx11 wayland"
makedepend="meson ninja"
source="https://github.com/intel/libva/archive/refs/tags/2.24.0.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libva-2.24.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libva-2.24.0"
	DESTDIR="$pkgdir" ninja -C build install
}
