name=gimp
version=3.2.0
release=1
desc="Image editor"
url="https://gimp.org/"
license="GPL-3.0-or-later"
depend="gtk3 babl gegl libjpeg-turbo libpng libtiff librsvg poppler"
makedepend="meson ninja"
source="https://download.gimp.org/gimp/v3.2/gimp-3.2.0.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "gimp-3.2.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "gimp-3.2.0"
	DESTDIR="$pkgdir" ninja -C build install
}
