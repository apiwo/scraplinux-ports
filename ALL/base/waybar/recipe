# waybar - Status bar for Wayland compositors
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=waybar
version=0.15.0
release=1
desc="Status bar for Wayland compositors"
url="https://github.com/Alexays/Waybar"
license="MIT"
depend="wayland gtk3 gtkmm3 jsoncpp libinput pipewire libnl"
recommend=""
makedepend="meson ninja"
source="https://github.com/Alexays/Waybar/archive/refs/tags/0.15.0.tar.gz"
sha256="SKIP"

build() {
	# Host meson is a python-exec wrapper, and with LD_LIBRARY_PATH still on
	# the sysroot it loads ScrapLinux's glibc and dies with "undefined symbol:
	# __pointer_chk_guard, version GLIBC_PRIVATE" before configuring anything.
	# The compiler gets --sysroot from CFLAGS, so nothing needs the variable.
	unset LD_LIBRARY_PATH
	cd "Waybar-0.15.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "Waybar-0.15.0"
	DESTDIR="$pkgdir" ninja -C build install
}
