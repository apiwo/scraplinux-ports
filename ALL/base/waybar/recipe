name=waybar
version=0.15.0
release=1
desc="Status bar for Wayland compositors"
url="https://github.com/Alexays/Waybar"
license="MIT"
depend="wayland gtk3 gtkmm3 jsoncpp libinput pipewire libnl"
makedepend="meson ninja"
source="https://github.com/Alexays/Waybar/archive/refs/tags/0.15.0.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "Waybar-0.15.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "Waybar-0.15.0"
	DESTDIR="$pkgdir" ninja -C build install
}
