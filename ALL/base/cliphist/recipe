name=cliphist
version=0.7.0
release=1
desc="Clipboard history for Wayland (wl-clipboard companion)"
url="https://github.com/sentriz/cliphist"
license="GPL-3.0"
depend="glibc"
makedepend="go"
source="https://github.com/sentriz/cliphist/archive/refs/tags/v0.7.0.tar.gz"
sha256="SKIP"

build() {
	cd "cliphist-0.7.0"
	export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	go build -o "cliphist" .
}

package() {
	cd "cliphist-0.7.0"
	install -Dm755 "cliphist" "$pkgdir/usr/bin/cliphist"
}
