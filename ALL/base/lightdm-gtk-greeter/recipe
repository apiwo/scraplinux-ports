name=lightdm-gtk-greeter
version=2.0.9
release=1
desc="The GTK greeter for LightDM"
url="https://github.com/Xubuntu/lightdm-gtk-greeter"
license="GPL-3.0-or-later"
depend="glibc lightdm gtk3"
makedepend=""
source="https://github.com/Xubuntu/lightdm-gtk-greeter/releases/download/lightdm-gtk-greeter-2.0.9/lightdm-gtk-greeter-2.0.9.tar.gz"
sha256="SKIP"

build() {
	cd "lightdm-gtk-greeter-2.0.9"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "lightdm-gtk-greeter-2.0.9"
	gmake DESTDIR="$pkgdir" install
}
