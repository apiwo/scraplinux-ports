name=gamescope
version=3.16.20
release=1
desc="Micro-compositor for games"
url="https://github.com/ValveSoftware/gamescope"
license="BSD-2-Clause"
depend="wlroots vulkan-loader mesa libxcb libxcomposite"
makedepend="meson ninja"
source="https://github.com/ValveSoftware/gamescope/archive/refs/tags/3.16.20.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "gamescope-3.16.20"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "gamescope-3.16.20"
	DESTDIR="$pkgdir" ninja -C build install
}
