name=nushell
version=0.109.0
release=1
desc="A shell built around structured data"
url="https://www.nushell.sh/"
license="MIT"
depend="glibc libressl"
makedepend="rust cargo"
source="https://github.com/nushell/nushell/archive/refs/tags/0.109.0.tar.gz"
sha256="SKIP"

build() {
	cd "nushell-0.109.0"
	export CARGO_HOME="${CARGO_HOME:-/tmp/scraplinux-cargo-home}"
	cargo build --release --locked
}

package() {
	cd "nushell-0.109.0"
	install -Dm755 "target/release/nushell" "$pkgdir/usr/bin/nushell"
	for d in README.md README LICENSE; do
		[ -f "$d" ] && install -Dm644 "$d" "$pkgdir/usr/share/doc/nushell/$d"
	done
	true
}
