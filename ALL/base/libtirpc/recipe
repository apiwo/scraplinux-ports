name=libtirpc
version=1.3.7
release=1
desc="TI-RPC library, needed by xorg-server (Xorg links against it directly)"
url="https://sourceforge.net/projects/libtirpc/"
license="BSD-3-Clause"
depend="glibc"
makedepend=""
source="libtirpc-1.3.7.tar.bz2::https://sourceforge.net/projects/libtirpc/files/libtirpc/1.3.7/libtirpc-1.3.7.tar.bz2/download"
sha256="SKIP"

build() {
	cd "libtirpc-1.3.7"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-gssapi*)  _opts="$_opts --disable-gssapi" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "libtirpc-1.3.7"
	gmake DESTDIR="$pkgdir" install
}
