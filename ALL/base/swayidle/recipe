name=swayidle
version=1.8.0
release=1
desc="Idle management daemon"
url="https://github.com/swaywm/swayidle"
license="MIT"
depend="wayland"
makedepend="meson ninja"
source="https://github.com/swaywm/swayidle/archive/refs/tags/1.8.0.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "swayidle-1.8.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "swayidle-1.8.0"
	DESTDIR="$pkgdir" ninja -C build install
}
