name=libsigcplusplus
version=3.6.0
release=1
desc="Typesafe callback framework"
url="https://libsigcplusplus.github.io/libsigcplusplus/"
license="LGPL-3.0-or-later"
depend="glibc"
makedepend="meson ninja"
source="https://download.gnome.org/sources/libsigc++/3.6/libsigc++-3.6.0.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "libsigc++-3.6.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "libsigc++-3.6.0"
	DESTDIR="$pkgdir" ninja -C build install
}
