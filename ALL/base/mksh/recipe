name=mksh
version=60c
release=1
desc="The MirBSD Korn shell"
url="https://www.mirbsd.org/mksh.htm"
license="MirOS"
depend="glibc"
makedepend=""
source="https://www.mirbsd.org/MirOS/dist/mir/mksh/mksh-R60c.tgz"
sha256="SKIP"

build() {
	cd "mksh-R60c"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "mksh-R60c"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
