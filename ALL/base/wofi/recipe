name=wofi
version=1.4.1
release=1
desc="Launcher for wlroots compositors"
url="https://hg.sr.ht/~scoopta/wofi"
license="GPL-3.0-only"
depend="wayland gtk3"
makedepend="meson ninja"
source="https://hg.sr.ht/~scoopta/wofi/archive/v1.4.1.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "wofi-1.4.1"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "wofi-1.4.1"
	DESTDIR="$pkgdir" ninja -C build install
}
