name=xorg-server
version=21.1.20
release=1
desc="The X.Org display server"
url="https://x.org/"
license="MIT"
depend="glibc mesa libdrm pixman libxkbcommon libxfont2 libtirpc libxcvt libxshmfence"
recommend="x11-base"
makedepend="meson ninja"
source="https://x.org/pub/individual/xserver/xorg-server-21.1.20.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "xorg-server-21.1.20"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "xorg-server-21.1.20"
	DESTDIR="$pkgdir" ninja -C build install
}
