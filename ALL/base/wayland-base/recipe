name=wayland-base
version=1.0.0
release=1
desc="Everything needed for a working Wayland session: wlroots, GL/EGL via glvnd, seatd, input, keymaps, Xwayland and fonts. Install this and a wlroots compositor runs."
url="https://github.com/apiwo/scraplinux"
license="GPL-3.0-or-later"
depend="wayland wayland-protocols wlroots libglvnd mesa libinput libxkbcommon xkeyboard-config pixman seatd libdrm libdisplay-info libxcb xcb-util-wm xcb-util-renderutil xcb-util-keysyms dbus ttf-jetbrains-mono-nerd"
makedepend=""
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/scraplinux/meta"
	printf '%s\n' "wayland wayland-protocols wlroots libglvnd mesa libinput libxkbcommon xkeyboard-config pixman seatd libdrm libdisplay-info libxcb xcb-util-wm xcb-util-renderutil xcb-util-keysyms dbus ttf-jetbrains-mono-nerd" >"$pkgdir/usr/share/scraplinux/meta/wayland-base"
}
