name=startup-notification
version=0.12
release=1
desc="Startup notification protocol library"
url="https://www.freedesktop.org/wiki/Software/startup-notification/"
license="LGPL-2.0-or-later"
depend="glibc libx11 libxcb xcb-util"
makedepend=""
source="https://www.freedesktop.org/software/startup-notification/releases/startup-notification-0.12.tar.gz"
sha256="SKIP"

build() {
	cd "startup-notification-0.12"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "startup-notification-0.12"
	gmake DESTDIR="$pkgdir" install
}
