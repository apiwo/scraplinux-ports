name=feh
version=3.10.3
release=1
desc="Lightweight image viewer and wallpaper setter"
url="https://feh.finalrewind.org/"
license="MIT"
depend="libx11 imlib2 libxt"
makedepend=""
source="https://feh.finalrewind.org/feh-3.10.3.tar.bz2"
sha256="SKIP"

build() {
	cd "feh-3.10.3"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "feh-3.10.3"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
