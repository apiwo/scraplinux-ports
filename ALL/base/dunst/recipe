name=dunst
version=1.13.0
release=1
desc="Notification daemon for X"
url="https://dunst-project.org/"
license="BSD-3-Clause"
depend="libx11 pango cairo libxinerama libxrandr dbus"
makedepend=""
source="https://github.com/dunst-project/dunst/archive/refs/tags/v1.13.0.tar.gz"
sha256="SKIP"

build() {
	cd "dunst-1.13.0"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "dunst-1.13.0"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
