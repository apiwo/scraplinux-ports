name=menu-cache
version=1.1.0
release=1
desc="Menu cache library for LXDE"
url="https://lxde.org/"
license="LGPL-2.1-or-later"
depend="glibc glib"
makedepend=""
source="https://downloads.sourceforge.net/lxde/menu-cache-1.1.0.tar.xz"
sha256="SKIP"

build() {
	export CFLAGS="$CFLAGS -fcommon"
	cd "menu-cache-1.1.0"
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	./configure $_opts
	make -j"$JOBS"
}

package() {
	cd "menu-cache-1.1.0"
	make DESTDIR="$pkgdir" install
}
