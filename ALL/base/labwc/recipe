name=labwc
version=0.20.2
release=1
desc="Stacking Wayland compositor with an Openbox look and feel"
url="https://github.com/labwc/labwc"
license="GPL-2.0-only"
depend="wlroots wayland cairo pango libxkbcommon wayland-protocols"
makedepend="meson ninja"
source="https://github.com/labwc/labwc/archive/refs/tags/0.20.2.tar.gz"
sha256="SKIP"

build() {
	cd "labwc-0.20.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "labwc-0.20.2"
	DESTDIR="$pkgdir" ninja -C build install
}
