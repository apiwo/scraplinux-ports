name=xcb-util-cursor
version=0.1.5
release=1
desc="Cursor loading for XCB, needed by Qt6's XCB platform plugin"
url="https://xcb.freedesktop.org/"
license="MIT"
depend="glibc libxcb xcb-util-renderutil xcb-util-image"
makedepend=""
source="https://xcb.freedesktop.org/dist/xcb-util-cursor-0.1.5.tar.xz"
sha256="SKIP"

build() {
	cd "xcb-util-cursor-0.1.5"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "xcb-util-cursor-0.1.5"
	gmake DESTDIR="$pkgdir" install
}
