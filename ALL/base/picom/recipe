# picom - X11 compositor, shadows and fading
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=picom
version=12.5
release=1
desc="X11 compositor, shadows and fading"
url="https://github.com/yshui/picom"
license="MIT MPL-2.0"
depend="libx11 libxcb mesa libconfig pixman libev"
recommend=""
makedepend="meson ninja"
source="https://github.com/yshui/picom/archive/refs/tags/v12.5.tar.gz"
sha256="SKIP"

build() {
	# Host meson is a python-exec wrapper, and with LD_LIBRARY_PATH still on
	# the sysroot it loads ScrapLinux's glibc and dies with "undefined symbol:
	# __pointer_chk_guard, version GLIBC_PRIVATE" before configuring anything.
	# The compiler gets --sysroot from CFLAGS, so nothing needs the variable.
	unset LD_LIBRARY_PATH
	cd "picom-12.5"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "picom-12.5"
	DESTDIR="$pkgdir" ninja -C build install
}
