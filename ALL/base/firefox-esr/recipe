name=firefox-esr
version=140.7.0
release=1
desc="Firefox Extended Support Release"
url="https://mozilla.org/firefox/"
license="MPL-2.0"
depend="glibc gtk3 mesa pipewire ffmpeg nss nspr icu"
makedepend="rust cargo nodejs python nasm"
source="https://archive.mozilla.org/pub/firefox/releases/140.7.0esr/source/firefox-140.7.0esr.source.tar.xz"
sha256="SKIP"

build() {
	cd "firefox-140.7.0esr.source"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "firefox-140.7.0esr.source"
	gmake DESTDIR="$pkgdir" install
}
