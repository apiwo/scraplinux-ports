name=libxscrnsaver
version=1.2.4
release=1
desc="X screen saver extension library"
url="https://x.org/"
license="MIT"
depend="glibc libx11 libxext"
makedepend=""
source="https://x.org/pub/individual/lib/libXScrnSaver-1.2.4.tar.xz"
sha256="SKIP"

build() {
	cd "libXScrnSaver-1.2.4"
	# scraps-build exports LD_LIBRARY_PATH pointing at the sysroot before
	# build() runs (for recipes that compile-and-run a target-linked
	# helper) - this recipe never does that, but the host's own shell
	# invoking ./configure --help inherits it anyway and can crash
	# loading the sysroot's libc.so.6 instead of its own. Same class of
	# bug as libcap/openrc this session.
	unset LD_LIBRARY_PATH
	# Not every configure script accepts the same options - sqlite rejects
	# --disable-nls outright, for instance - so only pass the ones this one
	# actually advertises. Guessing wrong fails the whole build.
	# libtool's linker-flavor detection doesn't recognize ld.lld and
	# leaves archive_cmds empty - the shared-library link step silently
	# never runs, no error, just no .so ever appears. ld.lld is GNU-ld
	# command-line compatible enough that telling libtool to assume GNU
	# ld fixes the detection.
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --with-gnu-ld"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	# bmake is not GNU make - automake's dependency-tracking .deps
	# fragments need nested variable expansion bmake doesn't have.
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	# shellcheck disable=SC2086
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "libXScrnSaver-1.2.4"
	gmake DESTDIR="$pkgdir" install
}
