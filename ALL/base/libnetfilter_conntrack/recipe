name=libnetfilter_conntrack
version=1.1.0
release=1
desc="Connection tracking library"
url="https://netfilter.org/projects/libnetfilter_conntrack/"
license="GPL-2.0-or-later"
depend="glibc libmnl libnfnetlink"
makedepend=""
source="https://netfilter.org/projects/libnetfilter_conntrack/files/libnetfilter_conntrack-1.1.0.tar.bz2"
sha256="SKIP"

build() {
	cd "libnetfilter_conntrack-1.1.0"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "libnetfilter_conntrack-1.1.0"
	gmake DESTDIR="$pkgdir" install
}
