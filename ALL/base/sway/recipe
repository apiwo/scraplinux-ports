name=sway
version=1.11
release=2
desc="i3-compatible Wayland compositor"
url="https://swaywm.org/"
license="MIT"
depend="glibc wayland wlroots libinput libxkbcommon pixman cairo pango json-c pcre2"
recommend="wayland-base foot swaybg swayidle swaylock"
makedepend="meson ninja"
source="https://github.com/swaywm/sway/releases/download/1.11/sway-1.11.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "sway-1.11"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "sway-1.11"
	DESTDIR="$pkgdir" ninja -C build install
}
