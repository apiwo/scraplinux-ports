name=vlc
version=3.0.22
release=1
desc="A feature-rich, cross-platform media player supporting nearly any format"
url="https://videolan.org/vlc/"
license="GPL-2.0-or-later"
depend="ffmpeg qt6-base alsa-lib libxcb mesa lua"
makedepend=""
source="https://download.videolan.org/pub/videolan/vlc/3.0.22/vlc-3.0.22.tar.xz"
sha256="SKIP"

build() {
	cd "vlc-3.0.22"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "vlc-3.0.22"
	gmake DESTDIR="$pkgdir" install
}
