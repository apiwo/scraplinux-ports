name=java-openjdk
version=25.0.2
release=1
desc="The OpenJDK Java runtime and compiler"
url="https://openjdk.org/"
license="GPL-2.0-only WITH Classpath-exception-2.0"
depend="glibc alsa-lib libx11 freetype fontconfig lcms2"
makedepend=""
source="https://github.com/openjdk/jdk25u/archive/refs/tags/jdk-25.0.2-ga.tar.gz"
sha256="SKIP"

build() {
	cd "jdk25u-jdk-25.0.2-ga"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "jdk25u-jdk-25.0.2-ga"
	gmake DESTDIR="$pkgdir" install
}
