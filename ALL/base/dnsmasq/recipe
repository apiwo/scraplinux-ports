name=dnsmasq
version=2.92
release=1
desc="Lightweight DNS and DHCP server"
url="https://thekelleys.org.uk/dnsmasq/"
license="GPL-2.0-only"
depend="glibc libnetfilter_conntrack"
makedepend=""
source="https://thekelleys.org.uk/dnsmasq/dnsmasq-2.92.tar.xz"
sha256="SKIP"

build() {
	cd "dnsmasq-2.92"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "dnsmasq-2.92"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
