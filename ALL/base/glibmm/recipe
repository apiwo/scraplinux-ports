name=glibmm
version=2.84.0
release=1
desc="C++ bindings for glib"
url="https://gtkmm.gnome.org/"
license="LGPL-2.1-or-later"
depend="glib libsigcplusplus"
makedepend="meson ninja"
source="https://download.gnome.org/sources/glibmm/2.84/glibmm-2.84.0.tar.xz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "glibmm-2.84.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "glibmm-2.84.0"
	DESTDIR="$pkgdir" ninja -C build install
}
