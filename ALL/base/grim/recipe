# grim - grab images from a Wayland compositor (wlr-screencopy).
name=grim
version=1.6.0
release=1
desc="Screenshot utility for Wayland compositors (wlr-screencopy)"
url="https://gitlab.freedesktop.org/emersion/grim"
license="MIT"
depend="wayland cairo libpng libjpeg-turbo pixman"
makedepend="meson ninja wayland-protocols"
# Moved from git.sr.ht to gitlab.freedesktop.org upstream; the old sr.ht
# archive URL no longer downloads.
source="https://gitlab.freedesktop.org/emersion/grim/-/archive/v$version/grim-v$version.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "grim-v$version"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Dman-pages=disabled \
		-Djpeg=enabled
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "grim-v$version"
	DESTDIR="$pkgdir" ninja -C build install
}
