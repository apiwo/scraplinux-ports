name=retroarch
version=1.22.0
release=1
desc="Frontend for emulators and game engines"
url="https://retroarch.com/"
license="GPL-3.0-only"
depend="mesa alsa-lib libxkbcommon wayland ffmpeg vulkan-loader"
makedepend=""
source="https://github.com/libretro/RetroArch/archive/refs/tags/v1.22.0.tar.gz"
sha256="SKIP"

build() {
	cd "RetroArch-1.22.0"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "RetroArch-1.22.0"
	gmake DESTDIR="$pkgdir" install
}
