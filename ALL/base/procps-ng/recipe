name=procps-ng
version=4.0.7
release=1
desc="Process monitoring utilities (ps, top, free); libproc2, needed by lxqt-session"
url="https://gitlab.com/procps-ng/procps"
license="GPL-2.0-or-later LGPL-2.1-or-later"
depend="glibc ncurses"
makedepend=""
source="https://downloads.sourceforge.net/project/procps-ng/Production/procps-ng-4.0.7.tar.xz"
sha256="SKIP"

build() {
	cd "procps-ng-4.0.7"
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "procps-ng-4.0.7"
	gmake DESTDIR="$pkgdir" install
}
