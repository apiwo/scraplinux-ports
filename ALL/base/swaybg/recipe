name=swaybg
version=1.2.2
release=1
desc="Wallpaper tool for Wayland"
url="https://github.com/swaywm/swaybg"
license="MIT"
depend="wayland cairo gdk-pixbuf"
makedepend="meson ninja"
source="https://github.com/swaywm/swaybg/archive/refs/tags/v1.2.2.tar.gz"
sha256="SKIP"

build() {
	unset LD_LIBRARY_PATH
	cd "swaybg-1.2.2"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	unset LD_LIBRARY_PATH
	cd "swaybg-1.2.2"
	DESTDIR="$pkgdir" ninja -C build install
}
