name=ScrapLinux-lts-kernel
version=6.12.60
release=1
desc="ScrapLinux kernel on the long-term support series"
url="https://kernel.org/"
license="GPL-2.0-only"
depend="glibc"
makedepend="clang lld bmake"
source="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.60.tar.xz"
sha256="SKIP"

build() {
	cd "linux-6.12.60"
	make -j"$JOBS" PREFIX=/usr
}

package() {
	cd "linux-6.12.60"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
