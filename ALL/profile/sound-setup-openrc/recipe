# sound-setup-openrc - the OpenRC counterpart to sound-setup: same audio
# stack, wired up through rc-update instead of the generic `service`
# wrapper, for a system explicitly running OpenRC as init.
name=sound-setup-openrc
version=1.0.0
release=1
desc="PipeWire audio, wired up and started (OpenRC)"
url="https://github.com/apiwo/scraplinux"
license="BSD-2-Clause"
depend="pipewire wireplumber pipewire-pulse alsa-lib alsa-utils openrc"
makedepend=""
source="session.sh"
sha256="SKIP"

package() {
	install -Dm755 session.sh "$pkgdir/etc/profile.d/50-pipewire-session.sh"
}
