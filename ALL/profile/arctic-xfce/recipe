# scraplinux-xfce - Xfce with the ScrapLinux look and foot as the terminal.
name=scraplinux-xfce
version=1.0.0
release=2
kind=profile
desc="Xfce with the ScrapLinux theme, foot and a neutral panel layout"
url="https://github.com/apiwo/scraplinux"
license="BSD-2-Clause"
# foot ships its own /etc/xdg/foot/foot.ini; this profile intentionally
# overrides it with the ScrapLinux-themed one below.
replaces="foot"
depend="xfce4-meta foot xfce4-notifyd xfce4-screenshooter thunar \
	xorg-server xorg-xinit xauth xterm sddm pipewire wireplumber \
	ttf-jetbrains-mono noto-fonts noto-fonts-emoji scraplinux-plasma-theme"
makedepend=""
source="foot.ini xfce4-desktop.xml xsettings.xml"
sha256="SKIP SKIP SKIP"
backup="etc/skel/.config/foot/foot.ini"

package() {
	install -Dm644 foot.ini "$pkgdir/etc/skel/.config/foot/foot.ini"
	install -Dm644 foot.ini "$pkgdir/etc/xdg/foot/foot.ini"

	x="$pkgdir/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
	install -Dm644 xfce4-desktop.xml "$x/xfce4-desktop.xml"
	install -Dm644 xsettings.xml     "$x/xsettings.xml"

	install -d "$pkgdir/usr/share/scraplinux/profiles"
	printf 'scraplinux-xfce\n' >"$pkgdir/usr/share/scraplinux/profiles/active"
}
