name=nvidia-alternative
version=1.0.0
release=1
desc="Everything needed to run an NVIDIA card without blobs"
url="https://nouveau.freedesktop.org/"
license="MIT"
depend="nouveau-drivers mesa nouveau-firmware"
makedepend=""
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/scraplinux/meta"
	printf '%s\n' "nouveau-drivers mesa nouveau-firmware" >"$pkgdir/usr/share/scraplinux/meta/nvidia-alternative"
}
