name=mesa-32
version=26.0.2
release=1
desc="OpenGL and Vulkan, 32-bit"
url="https://mesa3d.org/"
license="MIT"
depend="mesa glibc-32 libglvnd-32"
makedepend="meson ninja"
source="https://archive.mesa3d.org/mesa-26.0.2.tar.xz"
sha256="SKIP"

build() {
	cd "mesa-26.0.2"
	unset LD_LIBRARY_PATH
	unset CFLAGS CXXFLAGS LDFLAGS
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		--cross-file="$(dirname "$recipe")/i686-cross.ini" \
		-Dgallium-drivers=nouveau,softpipe \
		-Dvulkan-drivers= \
		-Dplatforms=x11 \
		-Dglx=dri \
		-Degl=enabled \
		-Dgbm=enabled \
		-Dllvm=disabled \
		-Dvideo-codecs= \
		-Dgallium-va=disabled
	ninja -C build -j"$JOBS"
}

package() {
	cd "mesa-26.0.2"
	DESTDIR="$pkgdir" ninja -C build install
	find "$pkgdir/usr" -mindepth 1 -maxdepth 1 ! -name lib32 -exec rm -rf {} +
}
