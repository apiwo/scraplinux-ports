# glibc-32 - The C library, 32-bit
# Hand-written - see recipe.local beside this file.
name=glibc-32
version=2.44
release=1
desc="The C library, 32-bit"
url="https://www.gnu.org/software/libc/"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend=""
source="https://ftp.gnu.org/gnu/glibc/glibc-2.44.tar.xz"
sha256="SKIP"
arch="i686"

build() {
	cd "glibc-2.44"
	mkdir -p build-32 && cd build-32
	CC="clang -m32" CXX="clang++ -m32" \
	../configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32/glibc \
		--host=i686-scraplinux-linux-gnu \
		--build=x86_64-scraplinux-linux-gnu \
		--enable-kernel=5.15 \
		--with-headers=/usr/include \
		libc_cv_slibdir=/usr/lib32
	make -j"$JOBS"
}

package() {
	cd "glibc-2.44/build-32"
	make install DESTDIR="$pkgdir" install_root="$pkgdir"
}
