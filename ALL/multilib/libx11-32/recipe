# libx11-32 - X11 client library, 32-bit
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=libx11-32
version=1.8.13
release=1
desc="X11 client library, 32-bit"
url="https://x.org/"
license="MIT"
depend="libx11 glibc-32"
makedepend=""
source="https://x.org/pub/individual/lib/libX11-1.8.13.tar.xz"
sha256="SKIP"

build() {
	cd "libX11-1.8.13"
	# Same reasoning as glibc-32: the outer CFLAGS/CXXFLAGS/LDFLAGS
	# scraps-build exports target 64-bit clang against the 64-bit sysroot -
	# start clean and build the 32-bit set explicitly. clang itself is fine
	# for ordinary userspace C (the glibc-32 clang problem was specific to
	# glibc's own weak_alias source, not clang -m32 in general).
	# Same LD_LIBRARY_PATH-poisoning fix as glibc-32/openrc/steam-runtime:
	# with a real, complete glibc-32 now published into the sysroot, even
	# /bin/sh crashes loading the sysroot's libc.so.6 while running
	# ./configure - fails silent and unhelpful (exit 127, no message,
	# because ./configure --help's own stderr is intentionally redirected
	# to /dev/null a few lines down).
	unset LD_LIBRARY_PATH
	unset CFLAGS CXXFLAGS LDFLAGS
	export CC="clang -m32" CXX="clang++ -m32"
	export PKG_CONFIG_PATH=/usr/lib32/pkgconfig:/usr/lib/pkgconfig
	[ -x ./configure ] || autoreconf -fi
	_opts="--prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib32 --host=i686-pc-linux-gnu"
	_help=$(./configure --help 2>/dev/null)
	case "$_help" in *--disable-static*)  _opts="$_opts --disable-static" ;; esac
	case "$_help" in *--disable-nls*)     _opts="$_opts --disable-nls" ;; esac
	case "$_help" in *--disable-dependency-tracking*) _opts="$_opts --disable-dependency-tracking" ;; esac
	# shellcheck disable=SC2086
	./configure $_opts
	gmake -j"$JOBS"
}

package() {
	cd "libX11-1.8.13"
	gmake DESTDIR="$pkgdir" install
	# `make install` puts headers (usr/include), locale data
	# (usr/share/X11/locale/locale.alias) and other arch-independent files
	# at the exact same paths the 64-bit libx11 package already owns -
	# identical content, not 32-bit-specific, but scraps still checks byte
	# content and correctly refuses when a build produced even a slightly
	# different copy: "file conflict: /usr/share/X11/locale/locale.alias is
	# owned by libx11". The 64-bit package already provides all of this;
	# a 32-bit libx11-32 only needs to contribute what's actually
	# architecture-specific, its runtime libraries.
	find "$pkgdir/usr" -mindepth 1 -maxdepth 1 ! -name lib32 -exec rm -rf {} +
}
