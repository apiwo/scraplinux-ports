name=libglvnd-32
version=1.7.0
release=1
desc="GL vendor dispatch, 32-bit"
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
license="MIT"
depend="glibc-32 libx11-32"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v1.7.0/libglvnd-v1.7.0.tar.gz"
sha256="SKIP"

build() {
	cd "libglvnd-v1.7.0"
	unset LD_LIBRARY_PATH
	unset CFLAGS CXXFLAGS LDFLAGS
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		--cross-file="$(dirname "$recipe")/../mesa-32/i686-cross.ini"
	ninja -C build -j"$JOBS"
}

package() {
	cd "libglvnd-v1.7.0"
	DESTDIR="$pkgdir" ninja -C build install
	ln -sf libOpenGL.so.0 "$pkgdir/usr/lib32/libGL.so.1"
	ln -sf libGL.so.1 "$pkgdir/usr/lib32/libGL.so"
	find "$pkgdir/usr" -mindepth 1 -maxdepth 1 ! -name lib32 -exec rm -rf {} +
}
