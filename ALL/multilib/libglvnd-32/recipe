# libglvnd-32 - GL vendor dispatch, 32-bit
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=libglvnd-32
version=1.7.0
release=1
desc="GL vendor dispatch, 32-bit"
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
license="MIT"
depend="glibc-32 libx11-32"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v1.7.0/libglvnd-v1.7.0.tar.gz"
sha256="SKIP"

build() {
	cd "libglvnd-v1.7.0"
	# Same LD_LIBRARY_PATH-poisoning fix as glibc-32/openrc/steam-runtime:
	# with a real, complete glibc-32 now published into the sysroot, plain
	# host tools this recipe's own build invokes (dirname, python-exec2c
	# via meson) crash loading the sysroot's libc.so.6 instead of the
	# host's own ("undefined symbol: __pointer_chk_guard, version
	# GLIBC_PRIVATE").
	unset LD_LIBRARY_PATH
	unset CFLAGS CXXFLAGS LDFLAGS
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		--cross-file="$(dirname "$recipe")/../mesa-32/i686-cross.ini"
	ninja -C build -j"$JOBS"
}

package() {
	cd "libglvnd-v1.7.0"
	DESTDIR="$pkgdir" ninja -C build install
	# Same reason the 64-bit libglvnd recipe does this: the GLVND-preferred
	# names (libOpenGL.so, libGLX.so) are not what most build systems look
	# for by default - they want the legacy libGL.so name.
	ln -sf libOpenGL.so.0 "$pkgdir/usr/lib32/libGL.so.1"
	ln -sf libGL.so.1 "$pkgdir/usr/lib32/libGL.so"
	# Same reason libx11-32 strips down to usr/lib32: headers and glvnd's
	# own vendor-config JSON land at the same paths the 64-bit libglvnd
	# package already owns. A 32-bit build only needs its runtime libraries.
	find "$pkgdir/usr" -mindepth 1 -maxdepth 1 ! -name lib32 -exec rm -rf {} +
}
